[package]
name = "win-native-media"
version = "0.1.1"
edition = "2021"
authors = ["Lotfi Bennour"]
description = "Native Windows media capture, encode, record, and stream pipeline. WGC → H.264 → MP4/RTMP, no FFmpeg."
documentation = "https://docs.rs/win-native-media"
homepage = "https://github.com/your-org/win-native-media"
repository = "https://github.com/your-org/win-native-media"
license = "MIT OR Apache-2.0"
keywords = ["windows", "media", "capture", "encode", "rtmp"]
categories = ["multimedia", "network-programming"]

[dependencies]
thiserror = "2"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
tokio = { version = "1", features = ["rt-multi-thread", "net", "time", "sync", "macros", "io-util"] }

[dependencies.windows]
version = "0.62"
features = [
    "Foundation",
    "Graphics_Capture",
    "Graphics_DirectX",
    "Graphics_DirectX_Direct3D11",
    "Win32_Foundation",
    "Win32_Graphics_Direct3D",
    "Win32_Graphics_Direct3D11",
    "Win32_Graphics_Dxgi",
    "Win32_Graphics_Dxgi_Common",
    "Win32_Graphics_Gdi",
    "Win32_System_WinRT",
    "Win32_System_WinRT_Direct3D11",
    "Win32_System_WinRT_Graphics_Capture",
    "Win32_System_Performance",
    "Win32_System_Com",
    "Win32_Media_MediaFoundation",
    "Win32_Media_KernelStreaming",
    "Win32_Media_Audio",
    "Win32_Media_Multimedia",
    "Win32_System_Ole",
    "Win32_System_Variant",
    "Win32_System_Com_StructuredStorage",
    "Win32_System_Threading",
    "Win32_Devices_FunctionDiscovery",
]

[dev-dependencies]
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
