            "compression": 0,
            "text": "import { default as __vite_glob_0_0 } from \"/templates/antigravity.html?import&raw\";import { default as __vite_glob_0_1 } from \"/templates/auth.html?import&raw\";import { default as __vite_glob_0_2 } from \"/templates/dashboard.html?import&raw\";import { default as __vite_glob_0_3 } from \"/templates/dns.html?import&raw\";import { default as __vite_glob_0_4 } from \"/templates/gemini-cli.html?import&raw\";import { default as __vite_glob_0_5 } from \"/templates/modals.html?import&raw\";import { default as __vite_glob_0_6 } from \"/templates/music.html?import&raw\";import { default as __vite_glob_0_7 } from \"/templates/openai.html?import&raw\";import { default as __vite_glob_0_8 } from \"/templates/openlist.html?import&raw\";import { default as __vite_glob_0_9 } from \"/templates/paas.html?import&raw\";import { default as __vite_glob_0_10 } from \"/templates/r2.html?import&raw\";import { default as __vite_glob_0_11 } from \"/templates/self-h.html?import&raw\";import { default as __vite_glob_0_12 } from \"/templates/server.html?import&raw\";import { default as __vite_glob_0_13 } from \"/templates/settings.html?import&raw\";import { default as __vite_glob_0_14 } from \"/templates/template.html?import&raw\";import { default as __vite_glob_0_15 } from \"/templates/totp.html?import&raw\";/**\r\n * 模板加载器 - 用于动态加载各模块的 HTML 模板\r\n * Refactored for Vite to bundle templates\r\n */\r\n\r\n// 使用 Vite 的 glob import 导入所有模板为原始字符串\r\nconst templateModules = /* #__PURE__ */ Object.assign({\"../templates/antigravity.html\": __vite_glob_0_0,\"../templates/auth.html\": __vite_glob_0_1,\"../templates/dashboard.html\": __vite_glob_0_2,\"../templates/dns.html\": __vite_glob_0_3,\"../templates/gemini-cli.html\": __vite_glob_0_4,\"../templates/modals.html\": __vite_glob_0_5,\"../templates/music.html\": __vite_glob_0_6,\"../templates/openai.html\": __vite_glob_0_7,\"../templates/openlist.html\": __vite_glob_0_8,\"../templates/paas.html\": __vite_glob_0_9,\"../templates/r2.html\": __vite_glob_0_10,\"../templates/self-h.html\": __vite_glob_0_11,\"../templates/server.html\": __vite_glob_0_12,\"../templates/settings.html\": __vite_glob_0_13,\"../templates/template.html\": __vite_glob_0_14,\"../templates/totp.html\": __vite_glob_0_15});\r\n\r\nconst TemplateLoader = {\r\n    // 模板映射关系 (filename -> selector)\r\n    templateMap: {\r\n        'auth.html': '#template-auth',\r\n        'dashboard.html': '#template-dashboard',\r\n        'paas.html': '#template-paas',\r\n        'dns.html': '#template-dns',\r\n        'gemini-cli.html': '#template-gemini-cli',\r\n        'openai.html': '#template-openai',\r\n        'server.html': '#template-server',\r\n        'self-h.html': '#template-self-h',\r\n        'antigravity.html': '#template-antigravity',\r\n        'settings.html': '#template-settings',\r\n        'modals.html': '#template-modals',\r\n        'r2.html': '#template-r2',\r\n        'totp.html': '#template-totp',\r\n        'music.html': '#template-music',\r\n    },\r\n\r\n    /**\r\n     * 加载所有模板\r\n     * @returns {Promise<void>}\r\n     */\r\n    async loadAll() {\r\n        const startTime = performance.now();\r\n        console.log('[TemplateLoader] Starting template loading (bundled)...');\r\n\r\n        try {\r\n            let loadedCount = 0;\r\n\r\n            for (const path in templateModules) {\r\n                const filename = path.split('/').pop();\r\n                const targetSelector = this.templateMap[filename];\r\n                const htmlContent = templateModules[path];\r\n\r\n                if (targetSelector) {\r\n                    const container = document.querySelector(targetSelector);\r\n                    if (container) {\r\n                        container.innerHTML = htmlContent;\r\n                        loadedCount++;\r\n                    } else {\r\n                        console.warn(`[TemplateLoader] Container ${targetSelector} not found for ${filename}`);\r\n                    }\r\n                }\r\n            }\r\n\r\n            const elapsed = Math.round(performance.now() - startTime);\r\n            console.log(`[TemplateLoader] ${loadedCount} templates injected in ${elapsed}ms`);\r\n\r\n            return true;\r\n        } catch (error) {\r\n            console.error('[TemplateLoader] Failed to load templates:', error);\r\n            throw error;\r\n        }\r\n    },\r\n\r\n    // 兼容旧 API，虽然不再需要单独加载\r\n    async loadTemplate(config) {\r\n        console.warn('[TemplateLoader] loadTemplate rule is deprecated in bundled mode');\r\n        return { target: config.target, html: '' };\r\n    },\r\n\r\n    clearCache() {\r\n        console.log('[TemplateLoader] Cache clear not needed in bundled mode');\r\n    },\r\n\r\n    setVersion(v) {\r\n        // No-op\r\n    }\r\n};\r\n\r\n// 导出给全局使用\r\nwindow.TemplateLoader = TemplateLoader;\r\n\r\nexport default TemplateLoader;\r\n\n//# sourceMappingURL=data:application/json;base64,"
