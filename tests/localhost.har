          "content": {
            "size": 3836,
            "mimeType": "text/javascript",
            "compression": 0,
            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/css/fly.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"E:/Code/api-monitor/src/css/fly.css\"\nconst __vite__css = \"/* Fly.io 模块专属样式 - 基于 Zeabur/Koyeb 样式 */\\r\\n\\r\\n/* \\r\\n * 说明:\\r\\n * 这个文件为 Fly.io 模块提供专属样式支持\\r\\n * 主要通过复写基础样式来对齐 Zeabur 和 Koyeb 的视觉效果\\r\\n */\\r\\n\\r\\n:root {\\r\\n    --fly-primary: #8b5cf6;\\r\\n    --fly-primary-rgb: 139, 92, 246;\\r\\n    --fly-secondary: #d946ef;\\r\\n}\\r\\n\\r\\n/* 双击编辑样式预览 - 应用名称 (对齐 Zeabur/Koyeb) */\\r\\n.paas-sec-tab .fly-project-name-text {\\r\\n    cursor: text;\\r\\n    user-select: none;\\r\\n    transition: all 0.2s ease;\\r\\n    padding: 2px 4px;\\r\\n    border-radius: 4px;\\r\\n}\\r\\n\\r\\n.paas-sec-tab .fly-project-name-text:hover {\\r\\n    background: rgba(var(--fly-primary-rgb), 0.08);\\r\\n    box-shadow: 0 0 0 1px rgba(var(--fly-primary-rgb), 0.2);\\r\\n}\\r\\n\\r\\n/* 双击编辑样式预览 - 服务名称 */\\r\\n.paas-sec-tab .fly-service-name {\\r\\n    cursor: text;\\r\\n    user-select: none;\\r\\n    transition: all 0.2s ease;\\r\\n    padding: 2px 4px;\\r\\n    border-radius: 4px;\\r\\n}\\r\\n\\r\\n.paas-sec-tab .fly-service-name:hover {\\r\\n    background: rgba(var(--fly-primary-rgb), 0.08);\\r\\n    box-shadow: 0 0 0 1px rgba(var(--fly-primary-rgb), 0.2);\\r\\n}\\r\\n\\r\\n/* 单应用模式 - 铺满一行 (对齐 Koyeb) */\\r\\n.paas-sec-tab .fly-projects-grid.single-app {\\r\\n    display: block;\\r\\n}\\r\\n\\r\\n.paas-sec-tab .fly-projects-grid.single-app .fly-project-card {\\r\\n    width: 100%;\\r\\n    max-width: 100%;\\r\\n}\\r\\n\\r\\n/* ========== Fly.io 专属视觉定制 (对齐其它模块) ========== */\\r\\n\\r\\n/* Account Card */\\r\\n.fly-account-card {\\r\\n    border-color: rgba(var(--fly-primary-rgb), 0.15);\\r\\n}\\r\\n\\r\\n/* 账号卡片展开状态的 Header 渐变 */\\r\\n.fly-account-card.expanded .fly-account-header {\\r\\n    background: linear-gradient(to right, rgba(var(--fly-primary-rgb), 0.05), transparent);\\r\\n}\\r\\n\\r\\n/* 账号头像渐变 */\\r\\n.fly-account-avatar {\\r\\n    background: linear-gradient(135deg, var(--fly-primary) 0%, var(--fly-secondary) 100%);\\r\\n    box-shadow: 0 3px 10px rgba(var(--fly-primary-rgb), 0.25);\\r\\n}\\r\\n\\r\\n/* 展开切换按钮颜色 */\\r\\n.fly-toggle {\\r\\n    background: rgba(var(--fly-primary-rgb), 0.08);\\r\\n    color: var(--fly-primary);\\r\\n}\\r\\n\\r\\n.fly-toggle.expanded {\\r\\n    background: rgba(var(--fly-primary-rgb), 0.15);\\r\\n}\\r\\n\\r\\n/* 项目卡片 Hover 高亮 */\\r\\n.fly-project-card:hover {\\r\\n    border-color: rgba(var(--fly-primary-rgb), 0.3);\\r\\n}\\r\\n\\r\\n/* 项目头部渐变 */\\r\\n.fly-project-header {\\r\\n    background: linear-gradient(to right, rgba(var(--fly-primary-rgb), 0.03), transparent);\\r\\n}\\r\\n\\r\\n/* 状态徽章映射修正 */\\r\\n.fly-service-item.running {\\r\\n    background-color: rgba(16, 185, 129, 0.1);\\r\\n    border-color: rgba(16, 185, 129, 0.2);\\r\\n}\\r\\n\\r\\n.fly-service-item.stopped {\\r\\n    background-color: rgba(239, 68, 68, 0.1);\\r\\n    border-color: rgba(239, 68, 68, 0.2);\\r\\n}\\r\\n\\r\\n/* 按钮颜色对齐 */\\r\\n.fly-btn {\\r\\n    background-color: rgba(var(--fly-primary-rgb), 0.1);\\r\\n    color: var(--fly-primary);\\r\\n}\\r\\n\\r\\n.fly-btn:hover {\\r\\n    background-color: rgba(var(--fly-primary-rgb), 0.2);\\r\\n    border-color: var(--fly-primary);\\r\\n}\\r\\n\\r\\n/* 域名链接颜色 */\\r\\n.fly-domain-link {\\r\\n    color: var(--fly-primary);\\r\\n}\\r\\n\\r\\n.fly-domain-link:hover {\\r\\n    border-color: var(--fly-primary);\\r\\n    background-color: var(--bg-tertiary);\\r\\n}\\r\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
