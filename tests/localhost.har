            "compression": 0,
            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/css/login.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"E:/Code/api-monitor/src/css/login.css\"\nconst __vite__css = \"/* Modern Auth Screen Styles */\\r\\n:root {\\r\\n    --auth-bg: #f0f4f8;\\r\\n    --auth-card-bg: #ffffff;\\r\\n    --auth-text-main: #1e293b;\\r\\n    --auth-text-muted: #64748b;\\r\\n    --auth-primary: #3b82f6;\\r\\n    --auth-primary-glow: rgba(59, 130, 246, 0.5);\\r\\n    --auth-input-bg: #f8fafc;\\r\\n    --auth-input-border: #e2e8f0;\\r\\n    --auth-error: #ef4444;\\r\\n    --auth-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -6px rgba(0, 0, 0, 0.04);\\r\\n}\\r\\n\\r\\n@media (prefers-color-scheme: dark) {\\r\\n    :root {\\r\\n        --auth-bg: #0f172a;\\r\\n        --auth-card-bg: #1e293b;\\r\\n        --auth-text-main: #f8fafc;\\r\\n        --auth-text-muted: #94a3b8;\\r\\n        --auth-primary: #3b82f6;\\r\\n        --auth-primary-glow: rgba(59, 130, 246, 0.3);\\r\\n        --auth-input-bg: #334155;\\r\\n        --auth-input-border: #475569;\\r\\n        --auth-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);\\r\\n    }\\r\\n}\\r\\n\\r\\n.auth-screen {\\r\\n    position: fixed;\\r\\n    top: 0;\\r\\n    left: 0;\\r\\n    width: 100%;\\r\\n    height: 100%;\\r\\n    background: var(--auth-bg);\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    justify-content: center;\\r\\n    z-index: 10000;\\r\\n    padding: 20px;\\r\\n    transition: all 0.3s ease;\\r\\n    pointer-events: auto;\\r\\n    /* 确保登录页可交互 */\\r\\n}\\r\\n\\r\\n.auth-card {\\r\\n    position: relative;\\r\\n    background: var(--auth-card-bg);\\r\\n    width: 100%;\\r\\n    max-width: 420px;\\r\\n    padding: 30px 30px;\\r\\n    border-radius: 32px;\\r\\n    box-shadow: var(--auth-shadow);\\r\\n    overflow: hidden;\\r\\n    animation: authPopIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);\\r\\n}\\r\\n\\r\\n@keyframes authPopIn {\\r\\n    0% {\\r\\n        opacity: 0;\\r\\n        transform: scale(0.9) translateY(20px);\\r\\n    }\\r\\n\\r\\n    100% {\\r\\n        opacity: 1;\\r\\n        transform: scale(1) translateY(0);\\r\\n    }\\r\\n}\\r\\n\\r\\n.auth-header {\\r\\n    text-align: center;\\r\\n    margin-bottom: 20px;\\r\\n}\\r\\n\\r\\n.auth-logo {\\r\\n    width: 72px;\\r\\n    height: 72px;\\r\\n    background: linear-gradient(135deg, #3b82f6, #2563eb);\\r\\n    color: white;\\r\\n    border-radius: 20px;\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    justify-content: center;\\r\\n    margin: 0 auto 24px;\\r\\n    font-size: 32px;\\r\\n    box-shadow: 6px 6px 9px 0px var(--auth-primary-glow);\\r\\n    position: relative;\\r\\n    z-index: 2;\\r\\n}\\r\\n\\r\\n.auth-logo.login-logo {\\r\\n    background: linear-gradient(135deg, #6366f1, #4f46e5);\\r\\n    box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);\\r\\n    transition: transform 0.2s ease, box-shadow 0.2s ease;\\r\\n    cursor: pointer;\\r\\n}\\r\\n\\r\\n.auth-logo.login-logo:hover {\\r\\n    transform: rotate(14deg);\\r\\n    box-shadow: 0 12px 28px rgba(99, 102, 241, 0.5);\\r\\n}\\r\\n\\r\\n.auth-header h1 {\\r\\n    font-size: 28px;\\r\\n    font-weight: 800;\\r\\n    color: var(--auth-text-main);\\r\\n    margin: 0 0 12px 0;\\r\\n    letter-spacing: -0.025em;\\r\\n}\\r\\n\\r\\n.auth-header p {\\r\\n    color: var(--auth-text-muted);\\r\\n    font-size: 15px;\\r\\n    margin: 0;\\r\\n}\\r\\n\\r\\n.auth-body {\\r\\n    display: flex;\\r\\n    flex-direction: column;\\r\\n    gap: 20px;\\r\\n    position: relative;\\r\\n    z-index: 2;\\r\\n}\\r\\n\\r\\n.auth-input-group {\\r\\n    position: relative;\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n}\\r\\n\\r\\n.input-icon {\\r\\n    position: absolute;\\r\\n    left: 16px;\\r\\n    color: var(--auth-text-muted);\\r\\n    font-size: 18px;\\r\\n    transition: color 0.3s ease;\\r\\n}\\r\\n\\r\\n.auth-input {\\r\\n    width: 100%;\\r\\n    padding: 16px 16px 16px 48px;\\r\\n    background: var(--auth-input-bg);\\r\\n    border: 2px solid var(--auth-input-border);\\r\\n    border-radius: 16px;\\r\\n    color: var(--auth-text-main);\\r\\n    font-size: 16px;\\r\\n    transition: all 0.3s ease;\\r\\n}\\r\\n\\r\\n.auth-input:focus {\\r\\n    outline: none;\\r\\n    border-color: var(--auth-primary);\\r\\n    background: var(--auth-card-bg);\\r\\n    box-shadow: 0 0 0 4px var(--auth-primary-glow);\\r\\n}\\r\\n\\r\\n.auth-input:focus+.input-icon {\\r\\n    color: var(--auth-primary);\\r\\n}\\r\\n\\r\\n.auth-error-msg {\\r\\n    background: rgba(239, 68, 68, 0.1);\\r\\n    color: var(--auth-error);\\r\\n    padding: 12px 16px;\\r\\n    border-radius: 12px;\\r\\n    font-size: 14px;\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    gap: 10px;\\r\\n    animation: authShake 0.4s ease-in-out;\\r\\n}\\r\\n\\r\\n@keyframes authShake {\\r\\n\\r\\n    0%,\\r\\n    100% {\\r\\n        transform: translateX(0);\\r\\n    }\\r\\n\\r\\n    25% {\\r\\n        transform: translateX(-5px);\\r\\n    }\\r\\n\\r\\n    75% {\\r\\n        transform: translateX(5px);\\r\\n    }\\r\\n}\\r\\n\\r\\n.auth-primary-btn {\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    justify-content: center;\\r\\n    gap: 12px;\\r\\n    padding: 16px;\\r\\n    background: var(--auth-primary);\\r\\n    color: white;\\r\\n    border: none;\\r\\n    border-radius: 16px;\\r\\n    font-size: 17px;\\r\\n    font-weight: 700;\\r\\n    cursor: pointer;\\r\\n    transition: all 0.3s ease;\\r\\n    margin-top: 8px;\\r\\n}\\r\\n\\r\\n.auth-primary-btn:hover {\\r\\n    filter: brightness(1.1);\\r\\n    transform: translateY(-2px);\\r\\n    box-shadow: 0 10px 15px -3px var(--auth-primary-glow);\\r\\n}\\r\\n\\r\\n.auth-primary-btn:active {\\r\\n    transform: translateY(0);\\r\\n}\\r\\n\\r\\n/* Background Decoration */\\r\\n.auth-footer-decoration {\\r\\n    position: absolute;\\r\\n    bottom: -50px;\\r\\n    right: -50px;\\r\\n    z-index: 1;\\r\\n}\\r\\n\\r\\n.circle {\\r\\n    position: absolute;\\r\\n    border-radius: 50%;\\r\\n    filter: blur(40px);\\r\\n}\\r\\n\\r\\n.c1 {\\r\\n    width: 150px;\\r\\n    height: 150px;\\r\\n    background: rgba(59, 130, 246, 0.15);\\r\\n    bottom: 20px;\\r\\n    right: 20px;\\r\\n}\\r\\n\\r\\n.c2 {\\r\\n    width: 100px;\\r\\n    height: 100px;\\r\\n    background: rgba(99, 102, 241, 0.15);\\r\\n    bottom: 60px;\\r\\n    right: 60px;\\r\\n}\\r\\n\\r\\n@media (max-width: 480px) {\\r\\n    .auth-card {\\r\\n        padding: 32px 24px;\\r\\n        border-radius: 24px;\\r\\n    }\\r\\n}\\r\\n\\r\\n/* 防止空模板容器阻挡点击 */\\r\\n#template-auth,\\r\\n#template-welcome {\\r\\n    pointer-events: none;\\r\\n}\\r\\n\\r\\n#template-auth>*,\\r\\n#template-welcome>* {\\r\\n    pointer-events: auto;\\r\\n}\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
