            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/css/template.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"E:/Code/api-monitor/src/css/template.css\"\nconst __vite__css = \"/**\\r\\n * 模板模块样式\\r\\n */\\r\\n.{{module_name}}-module {\\r\\n    padding: 20px;\\r\\n    animation: fadeIn 0.3s ease-in-out;\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .module-header {\\r\\n    display: flex;\\r\\n    justify-content: space-between;\\r\\n    align-items: center;\\r\\n    margin-bottom: 24px;\\r\\n    background: var(--bg-card);\\r\\n    padding: 16px 24px;\\r\\n    border-radius: 12px;\\r\\n    box-shadow: 0 4px 6px var(--shadow-color);\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .title-area {\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    gap: 12px;\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .title-area i {\\r\\n    font-size: 24px;\\r\\n    color: var(--primary-color);\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .title-area h2 {\\r\\n    margin: 0;\\r\\n    font-size: 20px;\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .data-grid {\\r\\n    display: grid;\\r\\n    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\\r\\n    gap: 20px;\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .data-card {\\r\\n    background: var(--bg-card);\\r\\n    border-radius: 12px;\\r\\n    padding: 20px;\\r\\n    border: 1px solid var(--border-color);\\r\\n    transition: transform 0.2s, box-shadow 0.2s;\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .data-card:hover {\\r\\n    transform: translateY(-4px);\\r\\n    box-shadow: 0 8px 15px var(--shadow-color);\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .card-header {\\r\\n    display: flex;\\r\\n    justify-content: space-between;\\r\\n    align-items: flex-start;\\r\\n    margin-bottom: 15px;\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .status-badge {\\r\\n    padding: 4px 8px;\\r\\n    border-radius: 4px;\\r\\n    font-size: 12px;\\r\\n    text-transform: uppercase;\\r\\n}\\r\\n\\r\\n.{{module_name}}-module .status-badge.active {\\r\\n    background: rgba(40, 167, 69, 0.2);\\r\\n    color: #28a745;\\r\\n}\\r\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
