            "mimeType": "text/javascript",
            "compression": 0,
            "text": "export default \"<transition name=\\\"settings-fade\\\">\\n  <div v-if=\\\"showSettingsModal\\\" class=\\\"settings-modal-wrapper\\\" :class=\\\"{'show-settings-active': showSettingsModal}\\\"\\n    @keydown.esc=\\\"handleSettingsEsc\\\" tabindex=\\\"-1\\\" @click.self=\\\"showSettingsModal = false\\\">\\n    <div class=\\\"settings-sidebar\\\">\\n      <!-- 侧边栏头部 -->\\n      <div class=\\\"settings-sidebar-header\\\">\\n        <div class=\\\"settings-sidebar-title\\\">\\n          <i class=\\\"fas fa-cog\\\"></i>\\n          <span>系统设置</span>\\n        </div>\\n        <button class=\\\"settings-sidebar-close\\\" @click=\\\"showSettingsModal = false\\\"><i class=\\\"fas fa-times\\\"></i></button>\\n      </div>\\n\\n      <!-- 侧边栏内容 -->\\n      <div class=\\\"settings-container\\\">\\n        <!-- settings-sidebar-left: Navigation -->\\n        <div class=\\\"settings-nav\\\">\\n          <button class=\\\"settings-nav-item\\\" :class=\\\"{ active: settingsCurrentTab === 'general' }\\\"\\n            @click=\\\"settingsCurrentTab = 'general'\\\">\\n            <i class=\\\"fas fa-cog\\\"></i> <span>通用设置</span>\\n          </button>\\n          <button class=\\\"settings-nav-item\\\" :class=\\\"{ active: settingsCurrentTab === 'api' }\\\"\\n            @click=\\\"settingsCurrentTab = 'api'\\\">\\n            <i class=\\\"fas fa-globe\\\"></i> <span>全局 API</span>\\n          </button>\\n          <button class=\\\"settings-nav-item\\\" :class=\\\"{ active: settingsCurrentTab === 'database' }\\\"\\n            @click=\\\"settingsCurrentTab = 'database'\\\">\\n            <i class=\\\"fas fa-database\\\"></i> <span>数据库</span>\\n          </button>\\n          <button class=\\\"settings-nav-item\\\" :class=\\\"{ active: settingsCurrentTab === 'logs' }\\\"\\n            @click=\\\"settingsCurrentTab = 'logs'\\\">\\n            <i class=\\\"fas fa-terminal\\\"></i> <span>系统日志</span>\\n          </button>\\n          <button class=\\\"settings-nav-item\\\" :class=\\\"{ active: settingsCurrentTab === 'appearance' }\\\"\\n            @click=\\\"settingsCurrentTab = 'appearance'\\\">\\n            <i class=\\\"fas fa-palette\\\"></i> <span>界面外观</span>\\n          </button>\\n          <button class=\\\"settings-nav-item\\\" :class=\\\"{ active: settingsCurrentTab === 'about' }\\\"\\n            @click=\\\"settingsCurrentTab = 'about'\\\">\\n            <i class=\\\"fas fa-info-circle\\\"></i> <span>关于系统</span>\\n          </button>\\n        </div>\\n\\n        <!-- settings-main: Content Area -->\\n        <div class=\\\"settings-main\\\">\\n          <!-- ==================== General Tab ==================== -->\\n          <div v-if=\\\"settingsCurrentTab === 'general'\\\" class=\\\"settings-tab-content fade-in\\\">\\n            <div class=\\\"settings-group\\\">\\n              <div class=\\\"settings-group-title\\\">账户安全 <span v-if=\\\"isDemoMode\\\" class=\\\"badge badge-warning\\\"\\n                  style=\\\"font-size: 10px; margin-left: 8px;\\\">演示模式</span></div>\\n              <div v-if=\\\"isDemoMode\\\" class=\\\"settings-description\\\"\\n                style=\\\"color: var(--warning-color); font-weight: 500;\\\">\\n                <i class=\\\"fas fa-exclamation-triangle\\\"></i> 演示模式下禁止修改管理员密码。\\n              </div>\\n              <div class=\\\"form-group\\\">\\n                <label class=\\\"form-label\\\">新密码</label>\\n                <input v-model=\\\"newPassword\\\" type=\\\"password\\\" class=\\\"form-input\\\" placeholder=\\\"输入新密码（至少6位）\\\"\\n                  :disabled=\\\"isDemoMode\\\" />\\n              </div>\\n              <div class=\\\"form-group\\\">\\n                <label class=\\\"form-label\\\">确认密码</label>\\n                <input v-model=\\\"confirmPassword\\\" type=\\\"password\\\" class=\\\"form-input\\\" placeholder=\\\"确认新密码\\\"\\n                  :disabled=\\\"isDemoMode\\\" />\\n              </div>\\n              <div v-if=\\\"passwordError\\\" class=\\\"form-error\\\">{{ passwordError }}</div>\\n              <div v-if=\\\"passwordSuccess\\\" class=\\\"form-success\\\">{{ passwordSuccess }}</div>\\n              <button class=\\\"btn btn-primary\\\" @click=\\\"changePassword\\\" style=\\\"width: 100%; margin-top: 8px;\\\"\\n                :disabled=\\\"isDemoMode\\\">\\n                <i class=\\\"fas fa-key\\\"></i> 修改密码\\n              </button>\\n            </div>\\n\\n            <div class=\\\"settings-grid-layout\\\">\\n              <div class=\\\"settings-group\\\" style=\\\"margin-bottom: 0; display: flex; flex-direction: column;\\\">\\n                <div class=\\\"settings-group-title\\\">数据备份 & 恢复</div>\\n                <div class=\\\"settings-description\\\">\\n                  导出包含所有模块配置和数据的.db文件，以便迁移或备份。\\n                </div>\\n                <div style=\\\"display: flex; gap: 8px; margin-top: auto; padding-top: 12px;\\\">\\n                  <button class=\\\"btn btn-secondary\\\" @click=\\\"exportAllData\\\" style=\\\"flex: 1;\\\">\\n                    <i class=\\\"fas fa-upload\\\"></i> 导出数据\\n                  </button>\\n                  <button class=\\\"btn btn-secondary\\\" @click=\\\"importAllData\\\" style=\\\"flex: 1;\\\">\\n                    <i class=\\\"fas fa-download\\\"></i> 导入数据\\n                  </button>\\n                </div>\\n              </div>\\n\\n              <div class=\\\"settings-group\\\" style=\\\"margin-bottom: 0; display: flex; flex-direction: column;\\\">\\n                <div class=\\\"settings-group-title\\\">隐私与安全显示</div>\\n                <div class=\\\"settings-description\\\">\\n                  控制主机地址、API 端点地址等敏感信息的显示方式。\\n                </div>\\n                <!-- 隐藏地址显示模式 -->\\n                <div class=\\\"form-group\\\" style=\\\"margin-top: auto; padding-top: 12px;\\\">\\n                  <label class=\\\"form-label\\\" style=\\\"font-size: 13px;\\\">地址显示模式</label>\\n                  <div style=\\\"display: flex; gap: 8px;\\\">\\n                    <button class=\\\"btn btn-sm\\\"\\n                      :class=\\\"serverIpDisplayMode === 'normal' ? 'btn-primary' : 'btn-secondary'\\\"\\n                      @click=\\\"serverIpDisplayMode = 'normal'\\\" style=\\\"flex: 1; height: 32px; font-size: 12px;\\\">\\n                      明文\\n                    </button>\\n                    <button class=\\\"btn btn-sm\\\"\\n                      :class=\\\"serverIpDisplayMode === 'masked' ? 'btn-primary' : 'btn-secondary'\\\"\\n                      @click=\\\"serverIpDisplayMode = 'masked'\\\" style=\\\"flex: 1; height: 32px; font-size: 12px;\\\">\\n                      打码\\n                    </button>\\n                    <button class=\\\"btn btn-sm\\\"\\n                      :class=\\\"serverIpDisplayMode === 'hidden' ? 'btn-primary' : 'btn-secondary'\\\"\\n                      @click=\\\"serverIpDisplayMode = 'hidden'\\\" style=\\\"flex: 1; height: 32px; font-size: 12px;\\\">\\n                      隐藏\\n                    </button>\\n                  </div>\\n                </div>\\n              </div>\\n            </div>\\n\\n            <!-- Agent 下载地址配置 -->\\n            <div class=\\\"settings-group\\\">\\n              <div class=\\\"settings-group-title\\\">\\n                <i class=\\\"fas fa-download\\\" style=\\\"color: var(--primary-color);\\\"></i> Agent 下载地址\\n              </div>\\n              <div class=\\\"settings-description\\\">\\n                配置 Agent 二进制文件的下载地址。默认使用主控端自身提供的文件。\\n              </div>\\n              <div class=\\\"form-group\\\" style=\\\"margin-top: 12px;\\\">\\n                <label class=\\\"form-label\\\" style=\\\"font-size: 13px;\\\">下载来源</label>\\n                <div style=\\\"display: flex; gap: 8px; margin-bottom: 12px;\\\">\\n                  <button class=\\\"btn btn-sm\\\" :class=\\\"!agentDownloadUrl ? 'btn-primary' : 'btn-secondary'\\\"\\n                    @click=\\\"agentDownloadUrl = ''\\\" style=\\\"flex: 1; height: 36px; font-size: 12px;\\\">\\n                    <i class=\\\"fas fa-server\\\" style=\\\"margin-right: 4px;\\\"></i> 使用主控端\\n                  </button>\\n                  <button class=\\\"btn btn-sm\\\" :class=\\\"agentDownloadUrl ? 'btn-primary' : 'btn-secondary'\\\"\\n                    @click=\\\"agentDownloadUrl = agentDownloadUrl || 'https://'\\\"\\n                    style=\\\"flex: 1; height: 36px; font-size: 12px;\\\">\\n                    <i class=\\\"fas fa-cloud\\\" style=\\\"margin-right: 4px;\\\"></i> 自定义 CDN\\n                  </button>\\n                </div>\\n                <div v-if=\\\"agentDownloadUrl !== undefined && agentDownloadUrl !== ''\\\">\\n                  <input type=\\\"text\\\" v-model=\\\"agentDownloadUrl\\\" class=\\\"form-input\\\"\\n                    placeholder=\\\"例如: https://github.com/user/repo/releases/download/v1.0\\\" />\\n                  <div class=\\\"form-help\\\" style=\\\"font-size: 11px; margin-top: 4px;\\\">\\n                    Agent 将从此地址下载对应架构的二进制文件 (如 agent-linux-amd64)\\n                  </div>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <!-- ==================== API Configuration Tab ==================== -->\\n          <div v-if=\\\"settingsCurrentTab === 'api'\\\" class=\\\"settings-tab-content fade-in\\\">\\n            <div class=\\\"settings-group\\\">\\n              <div class=\\\"settings-group-title\\\">全局 API & 网络配置</div>\\n              <div class=\\\"settings-description\\\">\\n                此处设置的 API 密钥和代理将统一应用于 Antigravity 和 Gemini CLI 模块。\\n              </div>\\n\\n              <div class=\\\"form-group\\\" style=\\\"margin-top: 16px;\\\">\\n                <label class=\\\"form-label\\\">全局 API 访问密钥 (API_KEY)</label>\\n                <div class=\\\"input-with-icon\\\">\\n                  <i class=\\\"fas fa-key\\\"></i>\\n                  <input type=\\\"password\\\" v-model=\\\"agSettingsForm.API_KEY\\\" class=\\\"form-input\\\" placeholder=\\\"留空则无需认证\\\" />\\n                </div>\\n                <div class=\\\"form-help\\\">用于 v1/chat/completions 等接口的身份验证</div>\\n              </div>\\n\\n              <div class=\\\"form-group\\\">\\n                <label class=\\\"form-label\\\">全局 HTTP 代理地址 (PROXY)</label>\\n                <div class=\\\"input-with-icon\\\">\\n                  <i class=\\\"fas fa-globe\\\"></i>\\n                  <input type=\\\"text\\\" v-model=\\\"agSettingsForm.PROXY\\\" class=\\\"form-input\\\"\\n                    placeholder=\\\"例如: http://127.0.0.1:7890\\\" />\\n                </div>\\n                <div class=\\\"form-help\\\">如果服务器无法直连 Google API，请配置代理</div>\\n              </div>\\n\\n              <div class=\\\"form-group\\\">\\n                <label class=\\\"form-label\\\">负载均衡策略 (Load Balancing)</label>\\n                <div class=\\\"input-with-icon\\\">\\n                  <i class=\\\"fas fa-balance-scale\\\"></i>\\n                  <select v-model=\\\"agSettingsForm.load_balancing_strategy\\\" class=\\\"form-input\\\">\\n                    <option value=\\\"random\\\">随机 (Random)</option>\\n                    <option value=\\\"round_robin\\\">轮询 (Round Robin)</option>\\n                  </select>\\n                </div>\\n                <div class=\\\"form-help\\\">决定多个启用账号之间的调用分配方式</div>\\n              </div>\\n\\n              <div class=\\\"form-group\\\" style=\\\"margin-top: 16px;\\\">\\n                <label class=\\\"form-label\\\">渠道模块开关</label>\\n                <div\\n                  style=\\\"display: flex; gap: 24px; padding: 10px; background: var(--bg-tertiary); border-radius: 8px;\\\">\\n                  <div style=\\\"display: flex; align-items: center; gap: 10px;\\\">\\n                    <label class=\\\"switch\\\">\\n                      <input type=\\\"checkbox\\\" :checked=\\\"channelEnabled && channelEnabled['antigravity']\\\"\\n                        @change=\\\"toggleChannelEnabled('antigravity')\\\">\\n                      <span class=\\\"slider round\\\"></span>\\n                    </label>\\n                    <span style=\\\"font-size: 13px; font-weight: 500;\\\">Antigravity</span>\\n                  </div>\\n\\n                  <div style=\\\"display: flex; align-items: center; gap: 10px;\\\">\\n                    <label class=\\\"switch\\\">\\n                      <input type=\\\"checkbox\\\" :checked=\\\"channelEnabled && channelEnabled['gemini-cli']\\\"\\n                        @change=\\\"toggleChannelEnabled('gemini-cli')\\\">\\n                      <span class=\\\"slider round\\\"></span>\\n                    </label>\\n                    <span style=\\\"font-size: 13px; font-weight: 500;\\\">Gemini CLI</span>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <div class=\\\"form-group\\\" style=\\\"margin-top: 16px;\\\">\\n                <label class=\\\"form-label\\\" style=\\\"font-size: 14px; font-weight: 600;\\\">模型前缀配置 (Model\\n                  Prefix)</label>\\n                <div class=\\\"form-help\\\" style=\\\"margin-bottom: 12px; font-size: 13px; opacity: 0.8;\\\">\\n                  为每个渠道的模型添加前缀，避免名称冲突\\n                  (例如 \\\"ag/\\\" 或 \\\"gcli/\\\")</div>\\n                <div style=\\\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px;\\\">\\n                  <div class=\\\"form-group\\\" style=\\\"margin-bottom: 0;\\\">\\n                    <label class=\\\"form-label\\\"\\n                      style=\\\"font-size: 12px; color: var(--text-secondary); margin-bottom: 4px; font-weight: 500;\\\">Antigravity\\n                      前缀</label>\\n                    <input type=\\\"text\\\" class=\\\"form-input\\\" v-model=\\\"channelModelPrefix['antigravity']\\\"\\n                      placeholder=\\\"例如: ag/\\\">\\n                  </div>\\n                  <div class=\\\"form-group\\\" style=\\\"margin-bottom: 0;\\\">\\n                    <label class=\\\"form-label\\\"\\n                      style=\\\"font-size: 12px; color: var(--text-secondary); margin-bottom: 4px; font-weight: 500;\\\">Gemini\\n                      CLI 前缀</label>\\n                    <input type=\\\"text\\\" class=\\\"form-input\\\" v-model=\\\"channelModelPrefix['gemini-cli']\\\"\\n                      placeholder=\\\"例如: gcli/\\\">\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <button class=\\\"btn btn-primary\\\" @click=\\\"saveGlobalApiSettings\\\" :disabled=\\\"antigravitySaving\\\"\\n                style=\\\"width: 100%; margin-top: 12px; height: 42px; font-weight: 600;\\\">\\n                <i class=\\\"fas\\\" :class=\\\"antigravitySaving ? 'fa-spinner fa-spin' : 'fa-save'\\\"></i>\\n                同步并应用配置\\n              </button>\\n            </div>\\n          </div>\\n\\n          <!-- ==================== Database Tab ==================== -->\\n          <div v-if=\\\"settingsCurrentTab === 'database'\\\" class=\\\"settings-tab-content fade-in\\\">\\n            <div class=\\\"settings-grid-layout\\\">\\n              <!-- 左侧：存储状态 -->\\n              <div class=\\\"settings-group\\\" style=\\\"margin-bottom: 0; display: flex; flex-direction: column;\\\">\\n                <div class=\\\"settings-group-title\\\" style=\\\"font-size: 16px; margin-bottom: 12px;\\\">\\n                  <i class=\\\"fas fa-database\\\" style=\\\"color: var(--primary-color);\\\"></i> 存储状态\\n                </div>\\n                <div class=\\\"db-stats-card\\\" style=\\\"margin-bottom: 15px; padding: 10px; gap: 15px; flex: 1;\\\">\\n                  <div class=\\\"db-stat-item\\\">\\n                    <div class=\\\"db-stat-label\\\" style=\\\"font-size: 10px;\\\">数据库大小</div>\\n                    <div style=\\\"display: flex; align-items: baseline; gap: 6px;\\\">\\n                      <div class=\\\"db-stat-value\\\" v-if=\\\"dbStats\\\" style=\\\"font-size: 20px;\\\">{{\\n                        formatFileSize(dbStats.dbSize) }}</div>\\n                      <div class=\\\"db-stat-value\\\" v-else>--</div>\\n                    </div>\\n                  </div>\\n                  <div class=\\\"db-stat-item\\\">\\n                    <div class=\\\"db-stat-label\\\" style=\\\"font-size: 10px;\\\">数据表总数</div>\\n                    <div class=\\\"db-stat-value\\\" v-if=\\\"dbStats\\\" style=\\\"font-size: 20px;\\\">{{ Object.keys(dbStats.tables ||\\n                      {}).length }} 个表</div>\\n                    <div class=\\\"db-stat-value\\\" v-else>--</div>\\n                  </div>\\n                </div>\\n                <div style=\\\"display: flex; gap: 10px; margin-top: auto;\\\">\\n                  <button class=\\\"btn btn-danger btn-sm\\\" @click=\\\"handleClearLogs\\\" style=\\\"flex: 1; height: 36px;\\\">\\n                    <i class=\\\"fas fa-trash-alt\\\"></i> 清空日志\\n                  </button>\\n                  <button class=\\\"btn btn-secondary btn-sm\\\" @click=\\\"handleVacuumDb\\\" style=\\\"flex: 1; height: 36px;\\\">\\n                    <i class=\\\"fas fa-compress-arrows-alt\\\"></i> 压缩存储\\n                  </button>\\n                </div>\\n              </div>\\n\\n              <!-- 右侧：自动清理策略 -->\\n              <div class=\\\"settings-group\\\" style=\\\"margin-bottom: 0; padding: 10px;\\\">\\n                <div class=\\\"settings-group-title\\\" style=\\\"font-size: 16px; margin-bottom: 8px;\\\">\\n                  <i class=\\\"fas fa-broom\\\" style=\\\"color: var(--primary-color);\\\"></i> 自动清理策略\\n                </div>\\n                <div class=\\\"settings-description\\\" style=\\\"font-size: 12px; margin-bottom: 15px;\\\">\\n                  系统将自动删除超过限制的旧日志数据。\\n                </div>\\n\\n                <div style=\\\"display: grid; grid-template-columns: 1fr; gap: 12px;\\\">\\n                  <div class=\\\"form-group\\\" style=\\\"margin-bottom: 0;\\\">\\n                    <label class=\\\"form-label\\\" style=\\\"font-size: 12px;\\\">日志保留天数</label>\\n                    <div class=\\\"input-with-suffix\\\">\\n                      <input v-model.number=\\\"logSettings.days\\\" type=\\\"number\\\" class=\\\"form-input\\\" min=\\\"0\\\" placeholder=\\\"0\\\"\\n                        @change=\\\"saveLogSettings\\\" style=\\\"height: 32px; font-size: 13px;\\\">\\n                      <span class=\\\"input-suffix\\\">天</span>\\n                    </div>\\n                  </div>\\n\\n                  <div class=\\\"form-group\\\" style=\\\"margin-bottom: 0;\\\">\\n                    <label class=\\\"form-label\\\" style=\\\"font-size: 12px;\\\">单表最大记录数</label>\\n                    <div class=\\\"input-with-suffix\\\">\\n                      <input v-model.number=\\\"logSettings.count\\\" type=\\\"number\\\" class=\\\"form-input\\\" min=\\\"0\\\" step=\\\"1000\\\"\\n                        placeholder=\\\"0\\\" @change=\\\"saveLogSettings\\\" style=\\\"height: 32px; font-size: 13px;\\\">\\n                      <span class=\\\"input-suffix\\\">条</span>\\n                    </div>\\n                  </div>\\n\\n                  <div class=\\\"form-group\\\" style=\\\"margin-bottom: 0;\\\">\\n                    <label class=\\\"form-label\\\" style=\\\"font-size: 12px;\\\">数据库最大体积</label>\\n                    <div class=\\\"input-with-suffix\\\">\\n                      <input v-model.number=\\\"logSettings.dbSizeMB\\\" type=\\\"number\\\" class=\\\"form-input\\\" min=\\\"0\\\"\\n                        placeholder=\\\"0\\\" @change=\\\"saveLogSettings\\\" style=\\\"height: 32px; font-size: 13px;\\\">\\n                      <span class=\\\"input-suffix\\\">MB</span>\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                <button class=\\\"btn btn-primary btn-sm\\\" style=\\\"width: 100%; margin-top: 15px; height: 36px;\\\"\\n                  @click=\\\"enforceLogLimits\\\" :disabled=\\\"logLimitsEnforcing\\\">\\n                  <i class=\\\"fas\\\" :class=\\\"logLimitsEnforcing ? 'fa-spinner fa-spin' : 'fa-magic'\\\"></i>\\n                  {{ logLimitsEnforcing ? '执行中...' : '立即执行清理' }}\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <!-- ==================== Logs Tab ==================== -->\\n          <div v-if=\\\"settingsCurrentTab === 'logs'\\\" class=\\\"settings-tab-content fade-in\\\"\\n            style=\\\"display: flex; flex-direction: column; height: 100%;\\\">\\n            <div class=\\\"settings-group\\\"\\n              style=\\\"display: flex; flex-direction: column; flex: 1; min-height: 0; padding: 15px; margin-bottom: 0;\\\">\\n              <div style=\\\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;\\\">\\n                <div style=\\\"display: flex; align-items: center; gap: 10px;\\\">\\n                  <span style=\\\"font-size: 15px; font-weight: 700; color: var(--text-primary);\\\">\\n                    <i class=\\\"fas fa-terminal\\\" style=\\\"margin-right: 4px; color: var(--primary-color);\\\"></i>实时运行日志\\n                  </span>\\n                  <span v-if=\\\"logFileSize\\\"\\n                    style=\\\"font-size: 10px; opacity: 0.5; font-family: var(--font-mono); background: var(--bg-tertiary); padding: 1px 6px; border-radius: 4px;\\\">\\n                    {{ logFileSize }}\\n                  </span>\\n                </div>\\n                <button class=\\\"btn btn-xs\\\" :class=\\\"logWsConnected ? 'btn-success' : 'btn-secondary'\\\"\\n                  @click=\\\"toggleLogStream\\\" style=\\\"height: 24px; padding: 0 10px; font-size: 11px;\\\">\\n                  <i class=\\\"fas\\\"\\n                    :class=\\\"logWsConnecting ? 'fa-spinner fa-spin' : (logWsConnected ? 'fa-link' : 'fa-link-slash')\\\"></i>\\n                  {{ logWsConnecting ? '连接中' : (logWsConnected ? '已开启' : '连接') }}\\n                </button>\\n              </div>\\n\\n              <div class=\\\"log-stream-container\\\" ref=\\\"settingsLogStream\\\"\\n                style=\\\"margin-bottom: 10px; border-radius: 6px;\\\">\\n                <div v-for=\\\"(log, index) in systemLogs\\\" :key=\\\"index\\\" class=\\\"log-item\\\"\\n                  style=\\\"margin-bottom: 4px; padding-bottom: 4px;\\\">\\n                  <div class=\\\"log-line log-line-header\\\">\\n                    <span class=\\\"log-time\\\">{{ log.time }}</span>\\n                    <span class=\\\"log-level\\\" :class=\\\"'log-' + (log.level || '').toLowerCase()\\\">\\n                      <i class=\\\"fas\\\" :class=\\\"getLogIcon(log.level)\\\"></i> {{ log.level }}\\n                    </span>\\n                  </div>\\n                  <div class=\\\"log-line log-line-content\\\">\\n                    <span class=\\\"log-module\\\" :class=\\\"'module-' + (log.module || 'core').toLowerCase()\\\">[{{ log.module\\n                      }}]</span>\\n                    <span class=\\\"log-msg\\\" v-html=\\\"formatMessage(log.message)\\\"></span>\\n                  </div>\\n                </div>\\n                <div v-if=\\\"systemLogs.length === 0\\\"\\n                  style=\\\"opacity: 0.3; text-align: center; padding: 20px; font-size: 11px;\\\">\\n                  等待日志输入...\\n                </div>\\n              </div>\\n              <div style=\\\"display: flex; gap: 8px; justify-content: space-between;\\\">\\n                <div style=\\\"display: flex; gap: 6px;\\\">\\n                  <button class=\\\"btn btn-secondary btn-xs\\\" @click=\\\"openSystemLogViewer\\\">\\n                    <i class=\\\"fas fa-expand\\\"></i> 全屏查看\\n                  </button>\\n                  <button class=\\\"btn btn-secondary btn-xs\\\" @click=\\\"viewRawAppLog\\\">\\n                    <i class=\\\"fas fa-file-alt\\\"></i> 查看文件\\n                  </button>\\n                </div>\\n                <button class=\\\"btn btn-danger btn-xs\\\" @click=\\\"clearAppLogs\\\">\\n                  <i class=\\\"fas fa-trash-alt\\\"></i> 清空内存\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <!-- ==================== Appearance Tab ==================== -->\\n          <div v-if=\\\"settingsCurrentTab === 'appearance'\\\" class=\\\"settings-tab-content fade-in\\\">\\n            <div class=\\\"settings-grid-layout\\\">\\n              <!-- 左侧：功能模块管理 -->\\n              <div class=\\\"settings-group\\\" style=\\\"margin-bottom: 0; display: flex; flex-direction: column;\\\">\\n                <div class=\\\"settings-group-title\\\"\\n                  style=\\\"display: flex; justify-content: space-between; align-items: center;\\\">\\n                  <span><i class=\\\"fas fa-cubes\\\"\\n                      style=\\\"margin-right: 8px; color: var(--primary-color);\\\"></i>功能模块管理</span>\\n                  <div style=\\\"display: flex; gap: 8px;\\\">\\n                    <button class=\\\"btn btn-xs btn-secondary\\\" @click=\\\"setAllModulesVisibility(true)\\\" title=\\\"显示所有模块\\\">\\n                      <i class=\\\"fas fa-eye\\\"></i>\\n                    </button>\\n                    <button class=\\\"btn btn-xs btn-secondary\\\" @click=\\\"setAllModulesVisibility(false)\\\" title=\\\"隐藏大部分模块\\\">\\n                      <i class=\\\"fas fa-eye-slash\\\"></i>\\n                    </button>\\n                  </div>\\n                </div>\\n                <div class=\\\"settings-description\\\">拖拽调整顺序，点击图标切换可见性。</div>\\n                <div class=\\\"modules-list\\\" style=\\\"flex: 1; overflow-y: auto; max-height: 400px; padding-right: 4px;\\\">\\n                  <div v-for=\\\"(module, index) in moduleOrder\\\" :key=\\\"module\\\" class=\\\"draggable-module-item\\\"\\n                    draggable=\\\"true\\\" @dragstart=\\\"handleDragStart($event, index)\\\" @dragend=\\\"handleDragEnd\\\"\\n                    @dragover.prevent=\\\"handleDragOver($event, index)\\\" @drop=\\\"handleDrop($event, index)\\\"\\n                    @touchstart=\\\"handleTouchStart($event, index)\\\" @touchmove=\\\"handleTouchMove($event, index)\\\"\\n                    @touchend=\\\"handleTouchEnd($event, index)\\\">\\n                    <div style=\\\"display: flex; align-items: center; gap: 8px; flex: 1;\\\">\\n                      <i class=\\\"fas fa-grip-vertical drag-handle\\\" style=\\\"font-size: 10px; opacity: 0.4;\\\"></i>\\n                      <i class=\\\"draggable-module-icon fas\\\" :class=\\\"getModuleIcon(module)\\\"\\n                        style=\\\"font-size: 14px; width: 16px; text-align: center;\\\"></i>\\n                      <span class=\\\"draggable-module-name\\\" style=\\\"font-size: 13px;\\\">{{ getModuleName(module) }}</span>\\n                    </div>\\n                    <button class=\\\"btn btn-xs btn-icon\\\"\\n                      :class=\\\"moduleVisibility[module] ? 'text-success' : 'text-muted'\\\"\\n                      @click.stop=\\\"toggleModuleVisibility(module)\\\">\\n                      <i class=\\\"fas\\\" :class=\\\"moduleVisibility[module] ? 'fa-eye' : 'fa-eye-slash'\\\"\\n                        style=\\\"font-size: 12px;\\\"></i>\\n                    </button>\\n                  </div>\\n                </div>\\n                <button class=\\\"btn btn-primary btn-sm\\\"\\n                  style=\\\"width: 100%; margin-top: 16px; height: 36px; font-size: 13px; font-weight: 600;\\\"\\n                  @click=\\\"saveSettings\\\">\\n                  <i class=\\\"fas fa-save\\\"></i> 应用排序与可见性\\n                </button>\\n              </div>\\n\\n              <!-- 右侧列：组合多个独立功能卡片 -->\\n              <div style=\\\"display: flex; flex-direction: column; gap: 20px;\\\">\\n                <!-- 界面布局卡片 (手机端隐藏，PC端可选) -->\\n                <div class=\\\"settings-group pc-only\\\" style=\\\"margin-bottom: 0; flex: 1;\\\">\\n                  <div class=\\\"settings-group-title\\\">\\n                    <i class=\\\"fas fa-columns\\\" style=\\\"color: var(--primary-color);\\\"></i> 界面布局\\n                  </div>\\n\\n                  <!-- 震动反馈开关 (移动端) -->\\n                  <div class=\\\"form-group\\\"\\n                    style=\\\"margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px dashed var(--border-color);\\\">\\n                    <div style=\\\"display: flex; align-items: center; justify-content: space-between;\\\">\\n                      <div>\\n                        <div style=\\\"font-size: 14px; font-weight: 600; color: var(--text-primary);\\\">触感反馈 (震动)</div>\\n                        <div style=\\\"font-size: 11px; color: var(--text-tertiary); margin-top: 2px;\\\">\\n                          开启后，移动端点击交互元素将提供物理震动反馈</div>\\n                      </div>\\n                      <label class=\\\"switch\\\">\\n                        <input type=\\\"checkbox\\\" v-model=\\\"vibrationEnabled\\\" @change=\\\"saveUserSettingsToServer\\\">\\n                        <span class=\\\"slider round\\\"></span>\\n                      </label>\\n                    </div>\\n                  </div>\\n\\n                  <div class=\\\"settings-description\\\">\\n                    选择主功能模块导航栏的显示位置。\\n                  </div>\\n                  <div class=\\\"form-group\\\" style=\\\"margin-top: 16px;\\\">\\n                    <label class=\\\"form-label\\\" style=\\\"font-size: 13px; font-weight: 600;\\\">导航栏显示位置</label>\\n                    <div style=\\\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;\\\">\\n                      <button class=\\\"btn btn-sm\\\" :class=\\\"navLayout === 'top' ? 'btn-primary' : 'btn-secondary'\\\"\\n                        @click=\\\"navLayout = 'top'; saveUserSettingsToServer()\\\" style=\\\"height: 40px; font-size: 12px;\\\">\\n                        <i class=\\\"fas fa-grip-lines\\\" style=\\\"margin-right: 4px;\\\"></i> 顶部\\n                      </button>\\n                      <button class=\\\"btn btn-sm\\\"\\n                        :class=\\\"navLayout === 'bottom-normal' ? 'btn-primary' : 'btn-secondary'\\\"\\n                        @click=\\\"navLayout = 'bottom-normal'; saveUserSettingsToServer()\\\"\\n                        style=\\\"height: 40px; font-size: 12px;\\\">\\n                        <i class=\\\"fas fa-grip-lines\\\" style=\\\"margin-right: 4px;\\\"></i> 底部\\n                      </button>\\n                      <button class=\\\"btn btn-sm\\\" :class=\\\"navLayout === 'bottom' ? 'btn-primary' : 'btn-secondary'\\\"\\n                        @click=\\\"navLayout = 'bottom'; saveUserSettingsToServer()\\\"\\n                        style=\\\"height: 40px; font-size: 12px;\\\">\\n                        <i class=\\\"fas fa-capsules\\\" style=\\\"margin-right: 4px;\\\"></i> 胶囊\\n                      </button>\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                <!-- CDN 加速配置卡片 (独立卡片) -->\\n                <div class=\\\"settings-group\\\" style=\\\"margin-bottom: 0; flex: 1;\\\">\\n                  <div class=\\\"settings-group-title\\\">\\n                    <i class=\\\"fas fa-bolt\\\" style=\\\"color: #f59e0b;\\\"></i> CDN 加速状态\\n                  </div>\\n                  <div class=\\\"settings-description\\\">静态资源加速服务当前运行状态。</div>\\n                  <div\\n                    style=\\\"background: var(--bg-tertiary); border-radius: 12px; padding: 10px; margin-top: 12px; border: 1px solid var(--border-color);\\\">\\n                    <div\\n                      style=\\\"display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;\\\">\\n                      <span style=\\\"font-size: 13px; color: var(--text-secondary);\\\">服务状态</span>\\n                      <span v-if=\\\"cdnEnabled\\\" class=\\\"status-badge\\\"\\n                        style=\\\"background: rgba(16, 185, 129, 0.15); color: #10b981; font-size: 11px; padding: 2px 8px; border-radius: 6px;\\\">\\n                        <i class=\\\"fas fa-check-circle\\\" style=\\\"margin-right: 4px;\\\"></i> 已启用\\n                      </span>\\n                      <span v-else class=\\\"status-badge\\\"\\n                        style=\\\"background: rgba(107, 114, 128, 0.15); color: #6b7280; font-size: 11px; padding: 2px 8px; border-radius: 6px;\\\">\\n                        <i class=\\\"fas fa-times-circle\\\" style=\\\"margin-right: 4px;\\\"></i> 已禁用\\n                      </span>\\n                    </div>\\n                    <div v-if=\\\"cdnEnabled\\\"\\n                      style=\\\"display: flex; align-items: center; justify-content: space-between; padding-top: 10px; border-top: 1px dashed var(--border-color);\\\">\\n                      <span style=\\\"font-size: 13px; color: var(--text-secondary);\\\">加速节点</span>\\n                      <span style=\\\"font-size: 13px; font-weight: 700; color: var(--primary-color);\\\">{{ cdnProvider\\n                        }}</span>\\n                    </div>\\n                  </div>\\n                </div>\\n              </div>\\n            </div> <!-- End settings-grid-layout -->\\n\\n            <div class=\\\"settings-group\\\" style=\\\"padding: 10px;\\\">\\n              <div class=\\\"settings-group-title\\\" style=\\\"font-size: 16px;\\\">\\n                <i class=\\\"fas fa-paint-brush\\\"></i> 自定义样式 (CSS)\\n              </div>\\n              <textarea v-model=\\\"customCss\\\" class=\\\"form-textarea code-font\\\" placeholder=\\\"/* 在此处输入 CSS 代码 */\\\"\\n                style=\\\"min-height: 80px;\\\"></textarea>\\n              <div v-if=\\\"customCssError\\\" class=\\\"form-error\\\" style=\\\"margin-top: 8px;\\\">{{ customCssError }}</div>\\n              <div v-if=\\\"customCssSuccess\\\" class=\\\"form-success\\\" style=\\\"margin-top: 8px;\\\">{{ customCssSuccess }}\\n              </div>\\n\\n              <div style=\\\"display: flex; gap: 12px; margin-top: 12px;\\\">\\n                <button class=\\\"btn btn-primary\\\" @click=\\\"saveCustomCss\\\" style=\\\"flex: 1;\\\">\\n                  <i class=\\\"fas fa-check\\\"></i> 应用样式\\n                </button>\\n                <button class=\\\"btn btn-secondary\\\" @click=\\\"resetCustomCss\\\" style=\\\"flex: 1;\\\">\\n                  <i class=\\\"fas fa-undo\\\"></i> 恢复默认\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <!-- ==================== About Tab ==================== -->\\n          <div v-if=\\\"settingsCurrentTab === 'about'\\\" class=\\\"settings-tab-content fade-in\\\">\\n            <div class=\\\"settings-group\\\" style=\\\"text-align: center;\\\">\\n              <div class=\\\"about-logo\\\">\\n                <img src=\\\"./logo.svg\\\" alt=\\\"Logo\\\" style=\\\"width: 100%; height: 100%; object-fit: contain;\\\">\\n              </div>\\n              <div style=\\\"font-size: 24px; font-weight: 800; color: var(--text-primary); margin-bottom: 8px;\\\">\\n                API Monitor\\n              </div>\\n              <div style=\\\"font-size: 14px; color: var(--text-tertiary); margin-bottom: 24px;\\\">\\n                Version β\\n              </div>\\n\\n              <div\\n                style=\\\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; max-width: 400px; margin: 0 auto; text-align: left;\\\">\\n                <div\\n                  style=\\\"background: var(--bg-secondary); padding: 10px; border-radius: 12px; border: 1px solid var(--border-color);\\\">\\n                  <div style=\\\"font-size: 11px; color: var(--text-tertiary); text-transform: uppercase;\\\">核心架构</div>\\n                  <div style=\\\"font-weight: 600; margin-top: 4px;\\\">DEBUG Engine</div>\\n                </div>\\n                <div\\n                  style=\\\"background: var(--bg-secondary); padding: 10px; border-radius: 12px; border: 1px solid var(--border-color);\\\">\\n                  <div style=\\\"font-size: 11px; color: var(--text-tertiary); text-transform: uppercase;\\\">AI 适配层</div>\\n                  <div style=\\\"font-weight: 600; margin-top: 4px;\\\">CloudCode Protocol</div>\\n                </div>\\n                <div\\n                  style=\\\"background: var(--bg-secondary); padding: 10px; border-radius: 12px; border: 1px solid var(--border-color);\\\">\\n                  <div style=\\\"font-size: 11px; color: var(--text-tertiary); text-transform: uppercase;\\\">运行环境</div>\\n                  <div style=\\\"font-weight: 600; margin-top: 4px;\\\">node js</div>\\n                </div>\\n                <div\\n                  style=\\\"background: var(--bg-secondary); padding: 10px; border-radius: 12px; border: 1px solid var(--border-color);\\\">\\n                  <div style=\\\"font-size: 11px; color: var(--text-tertiary); text-transform: uppercase;\\\">项目主页</div>\\n                  <div style=\\\"font-weight: 600; margin-top: 4px;\\\">\\n                    <a href=\\\"https://github.com/iwvw/API-Monitor\\\" target=\\\"_blank\\\"\\n                      style=\\\"color: var(--primary-color); text-decoration: none;\\\">\\n                      <i class=\\\"fab fa-github\\\"></i> API-Monitor\\n                    </a>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <div style=\\\"margin-top: 32px; border-top: 1px solid var(--border-color); padding-top: 24px;\\\">\\n                <p style=\\\"font-size: 13px; color: var(--text-secondary); line-height: 1.6;\\\">\\n                  专业的 API 监控与分发管理系统，<br>\\n                  旨在为 AI 应用提供极致的稳定性与性能。<br>\\n                  <span style=\\\"font-size: 11px; opacity: 0.6; margin-top: 8px; display: block;\\\">Powered by <a\\n                      href=\\\"https://github.com/iwvw/API-Monitor\\\" target=\\\"_blank\\\"\\n                      style=\\\"color: inherit;\\\">API-Monitor</a></span>\\n                </p>\\n              </div>\\n            </div>\\n          </div>\\n\\n        </div> <!-- End settings-main -->\\n      </div> <!-- End settings-container -->\\n    </div> <!-- End settings-sidebar -->\\n  </div> <!-- End settings-modal-wrapper -->\\n</transition>\"\n//# sourceMappingURL=data:application/json;base64,"
