            "text": "export default \"<!-- ==================== 自建服务模块 (Self-H) ==================== -->\\r\\n<div v-show=\\\"mainActiveTab === 'self-h'\\\" class=\\\"tab-content self-h-tab-content theme-self-h\\\"\\r\\n    :class=\\\"getTabAnimationClass('self-h')\\\">\\r\\n\\r\\n    <!-- 二级导航栏 -->\\r\\n    <div class=\\\"sec-tabs server-sec-tabs\\\">\\r\\n        <div class=\\\"server-tabs-scroll-wrapper\\\">\\r\\n            <button class=\\\"tab-btn\\\" :class=\\\"{ active: openListSubTab === 'files' }\\\" @click=\\\"switchOpenListTab('files')\\\">\\r\\n                <i class=\\\"fas fa-folder-open\\\"></i> 文件列表\\r\\n            </button>\\r\\n            <button class=\\\"tab-btn\\\" :class=\\\"{ active: openListSubTab === 'settings' }\\\"\\r\\n                @click=\\\"switchOpenListTab('settings')\\\">\\r\\n                <i class=\\\"fas fa-cog\\\"></i> 设置\\r\\n            </button>\\r\\n            <button class=\\\"tab-btn\\\" :class=\\\"{ active: openListSubTab === 'cron' }\\\" @click=\\\"switchOpenListTab('cron')\\\">\\r\\n                <i class=\\\"fas fa-clock\\\"></i> 定时任务\\r\\n            </button>\\r\\n            <!-- 临时标签页列表 -->\\r\\n            <button v-for=\\\"tab in openListTempTabs\\\" :key=\\\"tab.id\\\" class=\\\"tab-btn temp-tab\\\"\\r\\n                :class=\\\"{ active: openListSubTab === 'temp' && openListActiveTempTabId === tab.id }\\\"\\r\\n                @click=\\\"handleTabTap(tab.id)\\\" @auxclick.middle.stop=\\\"closeOpenListTempTab(tab.id)\\\"\\r\\n                :title=\\\"tab.name + ' (双击关闭)'\\\">\\r\\n                <i :class=\\\"tab.icon || 'fas fa-file'\\\"></i> <span>{{ tab.name }}</span>\\r\\n            </button>\\r\\n        </div>\\r\\n    </div>\\r\\n\\r\\n    <!-- 内容区域 -->\\r\\n    <div class=\\\"sub-tab-content quick-fade-in\\\">\\r\\n\\r\\n        <!-- 1. 文件列表 -->\\r\\n        <div v-if=\\\"openListSubTab === 'files'\\\" class=\\\"openlist-files-layout\\\">\\r\\n            <div v-if=\\\"!currentOpenListAccount\\\" class=\\\"empty-state\\\" style=\\\"margin-top: 40px;\\\">\\r\\n                <div class=\\\"empty-icon\\\"><i class=\\\"fas fa-plug\\\"></i></div>\\r\\n                <p>尚未连接 OpenList 实例</p>\\r\\n                <button class=\\\"btn btn-primary\\\" @click=\\\"switchOpenListTab('settings')\\\">\\r\\n                    <i class=\\\"fas fa-plus\\\"></i> 前往配置\\r\\n                </button>\\r\\n            </div>\\r\\n\\r\\n            <div v-else class=\\\"openlist-main-view\\\">\\r\\n                <!-- 顶部工具栏 (Header Area) -->\\r\\n                <div class=\\\"openlist-toolbar-standalone\\\">\\r\\n                    <div class=\\\"toolbar-left\\\">\\r\\n                        <!-- 账号切换 -->\\r\\n                        <div class=\\\"account-pill\\\" v-if=\\\"openListAccounts.length > 1\\\">\\r\\n                            <select :value=\\\"currentOpenListAccount?.id\\\"\\r\\n                                @change=\\\"e => selectOpenListAccountById(e.target.value)\\\">\\r\\n                                <option v-for=\\\"acc in openListAccounts\\\" :key=\\\"acc.id\\\" :value=\\\"acc.id\\\">{{ acc.name }}\\r\\n                                </option>\\r\\n                            </select>\\r\\n                            <i class=\\\"fas fa-caret-down\\\"></i>\\r\\n                        </div>\\r\\n\\r\\n                        <!-- 面包屑导航 -->\\r\\n                        <div class=\\\"breadcrumb-fluid-container\\\">\\r\\n                            <button class=\\\"bc-node\\\" @click=\\\"loadOpenListFiles('/')\\\"><i class=\\\"fas fa-home\\\"></i></button>\\r\\n                            <template v-for=\\\"(part, index) in openListPathParts\\\" :key=\\\"part.path\\\">\\r\\n                                <i class=\\\"fas fa-chevron-right bc-divider\\\"></i>\\r\\n                                <button class=\\\"bc-node\\\" :class=\\\"{ 'active': index === openListPathParts.length - 1 }\\\"\\r\\n                                    @click=\\\"loadOpenListFiles(part.path)\\\">\\r\\n                                    {{ part.name }}\\r\\n                                </button>\\r\\n                            </template>\\r\\n                        </div>\\r\\n                    </div>\\r\\n\\r\\n                    <!-- 右侧搜索 -->\\r\\n                    <!-- 右侧工具栏 -->\\r\\n                    <div class=\\\"toolbar-right\\\">\\r\\n                        <!-- 视图切换 -->\\r\\n                        <div class=\\\"view-toggle-group\\\">\\r\\n                            <button class=\\\"btn btn-icon-refined sm\\\" :class=\\\"{ active: openListLayoutMode === 'list' }\\\"\\r\\n                                @click=\\\"toggleOpenListLayout('list')\\\" title=\\\"列表视图\\\">\\r\\n                                <i class=\\\"fas fa-list\\\"></i>\\r\\n                            </button>\\r\\n                            <button class=\\\"btn btn-icon-refined sm\\\" :class=\\\"{ active: openListLayoutMode === 'grid' }\\\"\\r\\n                                @click=\\\"toggleOpenListLayout('grid')\\\" title=\\\"网格视图\\\">\\r\\n                                <i class=\\\"fas fa-th-large\\\"></i>\\r\\n                            </button>\\r\\n                        </div>\\r\\n                        <div class=\\\"divider-vertical\\\"></div>\\r\\n\\r\\n                        <button class=\\\"btn btn-icon-refined\\\" @click=\\\"mkdirOpenList\\\" title=\\\"新建文件夹\\\"><i\\r\\n                                class=\\\"fas fa-folder-plus\\\"></i></button>\\r\\n                        <button class=\\\"btn btn-icon-refined\\\" @click=\\\"loadOpenListFiles(openListPath, true)\\\"\\r\\n                            title=\\\"刷新\\\"><i class=\\\"fas fa-sync-alt\\\"\\r\\n                                :class=\\\"{ 'fa-spin': openListFilesLoading }\\\"></i></button>\\r\\n                    </div>\\r\\n                </div>\\r\\n\\r\\n                <!-- 文件列表区域 (Scrolling Area) -->\\r\\n                <div class=\\\"openlist-list-container\\\">\\r\\n                    <!-- 列表视图 -->\\r\\n                    <table class=\\\"data-table sticky-header\\\" style=\\\"width: 100%;\\\"\\r\\n                        v-if=\\\"!openListLayoutMode || openListLayoutMode === 'list'\\\">\\r\\n                        <thead>\\r\\n                            <tr>\\r\\n                                <th class=\\\"col-name\\\" @click=\\\"toggleOpenListSort('name')\\\">名称 <i\\r\\n                                        v-if=\\\"openListSortKey === 'name'\\\" class=\\\"fas\\\"\\r\\n                                        :class=\\\"openListSortOrder === 'asc' ? 'fa-sort-up' : 'fa-sort-down'\\\"></i></th>\\r\\n                                <th class=\\\"col-size\\\" @click=\\\"toggleOpenListSort('size')\\\">大小 <i\\r\\n                                        v-if=\\\"openListSortKey === 'size'\\\" class=\\\"fas\\\"\\r\\n                                        :class=\\\"openListSortOrder === 'asc' ? 'fa-sort-up' : 'fa-sort-down'\\\"></i></th>\\r\\n                                <th class=\\\"col-time hide-on-mobile\\\" @click=\\\"toggleOpenListSort('modified')\\\">修改时间 <i\\r\\n                                        v-if=\\\"openListSortKey === 'modified'\\\" class=\\\"fas\\\"\\r\\n                                        :class=\\\"openListSortOrder === 'asc' ? 'fa-sort-up' : 'fa-sort-down'\\\"></i></th>\\r\\n                            </tr>\\r\\n                        </thead>\\r\\n                        <tbody v-if=\\\"sortedOpenListFiles.length > 0\\\">\\r\\n                            <tr v-for=\\\"file in sortedOpenListFiles\\\" :key=\\\"file.name\\\" @click=\\\"handleOpenFile(file)\\\"\\r\\n                                @contextmenu=\\\"showFileContextMenu($event, file, openListPath)\\\"\\r\\n                                @touchstart=\\\"handleFileTouchStart($event, file, openListPath)\\\"\\r\\n                                @touchend=\\\"handleFileTouchEnd($event)\\\" @touchmove=\\\"handleFileTouchMove()\\\"\\r\\n                                @auxclick.middle.stop=\\\"handleMiddleClickItem(file)\\\">\\r\\n                                <td class=\\\"col-name\\\">\\r\\n                                    <div class=\\\"file-cell-main\\\">\\r\\n                                        <div class=\\\"file-icon-wrapper\\\">\\r\\n                                            <img v-if=\\\"getFileThumbnail(file)\\\" :src=\\\"getFileThumbnail(file)\\\"\\r\\n                                                class=\\\"file-thumb-icon\\\" referrerpolicy=\\\"no-referrer\\\" loading=\\\"lazy\\\"\\r\\n                                                @mouseenter=\\\"showHoverPreview($event, getFileThumbnail(file))\\\"\\r\\n                                                @mousemove=\\\"moveHoverPreview($event)\\\" @mouseleave=\\\"hideHoverPreview\\\"\\r\\n                                                @touchstart.stop=\\\"showHoverPreview($event, getFileThumbnail(file))\\\"\\r\\n                                                @touchend.stop=\\\"hideHoverPreview\\\" />\\r\\n                                            <i v-else :class=\\\"getFileIconClass(file)\\\"></i>\\r\\n                                        </div>\\r\\n                                        <span class=\\\"file-name-text\\\" :title=\\\"file.name\\\">{{ file.name }}</span>\\r\\n                                    </div>\\r\\n                                </td>\\r\\n                                <td class=\\\"col-size font-mono text-secondary\\\">{{ getOpenListFileSize(file) || '-' }}\\r\\n                                </td>\\r\\n                                <td class=\\\"col-time text-tertiary hide-on-mobile\\\">{{ formatDateTime(file.modified) }}\\r\\n                                </td>\\r\\n                            </tr>\\r\\n                        </tbody>\\r\\n                        <!-- 空状态 -->\\r\\n                        <tbody v-else-if=\\\"!openListFilesLoading\\\">\\r\\n                            <tr>\\r\\n                                <td colspan=\\\"3\\\" style=\\\"border: none;\\\">\\r\\n                                    <div class=\\\"openlist-empty-state\\\">\\r\\n                                        <i class=\\\"fas fa-folder-open\\\"></i>\\r\\n                                        <p>当前目录为空</p>\\r\\n                                    </div>\\r\\n                                </td>\\r\\n                            </tr>\\r\\n                        </tbody>\\r\\n                    </table>\\r\\n\\r\\n                    <!-- 网格视图 (瀑布流/Grid) -->\\r\\n                    <div class=\\\"openlist-grid-view\\\" v-else-if=\\\"openListLayoutMode === 'grid'\\\">\\r\\n                        <div v-if=\\\"sortedOpenListFiles.length > 0\\\" class=\\\"file-grid-container\\\">\\r\\n                            <div v-for=\\\"file in sortedOpenListFiles\\\" :key=\\\"file.name\\\" class=\\\"file-grid-item\\\"\\r\\n                                @click=\\\"handleOpenFile(file)\\\"\\r\\n                                @contextmenu=\\\"showFileContextMenu($event, file, openListPath)\\\"\\r\\n                                @touchstart=\\\"handleFileTouchStart($event, file, openListPath)\\\"\\r\\n                                @touchend=\\\"handleFileTouchEnd($event)\\\" @touchmove=\\\"handleFileTouchMove()\\\"\\r\\n                                @auxclick.middle.stop=\\\"handleMiddleClickItem(file)\\\">\\r\\n\\r\\n                                <div class=\\\"grid-item-preview\\\">\\r\\n                                    <img v-if=\\\"getFileThumbnail(file)\\\" :src=\\\"getFileThumbnail(file)\\\"\\r\\n                                        class=\\\"grid-thumb-img\\\" referrerpolicy=\\\"no-referrer\\\" loading=\\\"lazy\\\" />\\r\\n                                    <div v-else class=\\\"grid-icon-placeholder\\\">\\r\\n                                        <i :class=\\\"getFileIconClass(file)\\\"></i>\\r\\n                                    </div>\\r\\n                                </div>\\r\\n                                <div class=\\\"grid-item-info\\\">\\r\\n                                    <div class=\\\"grid-item-name\\\" :title=\\\"file.name\\\">{{ file.name }}</div>\\r\\n                                    <div class=\\\"grid-item-meta\\\">\\r\\n                                        {{ file.is_dir ? formatDateTime(file.modified) : (getOpenListFileSize(file) ||\\r\\n                                        '-') }}\\r\\n                                    </div>\\r\\n                                </div>\\r\\n                            </div>\\r\\n                        </div>\\r\\n                        <!-- 空状态 (Grid) -->\\r\\n                        <div v-else-if=\\\"!openListFilesLoading\\\" class=\\\"openlist-empty-state\\\">\\r\\n                            <i class=\\\"fas fa-folder-open\\\"></i>\\r\\n                            <p>当前目录为空</p>\\r\\n                        </div>\\r\\n                    </div>\\r\\n\\r\\n                    <!-- 加载骨架 -->\\r\\n                    <div v-if=\\\"openListFilesLoading\\\" class=\\\"list-loading-shimmer\\\">\\r\\n                        <div v-for=\\\"i in 10\\\" :key=\\\"i\\\" class=\\\"shimmer-row\\\"></div>\\r\\n                    </div>\\r\\n\\r\\n                    <!-- README -->\\r\\n                    <div v-if=\\\"openListReadme\\\" class=\\\"readme-footer\\\">\\r\\n                        <div class=\\\"readme-label\\\"><i class=\\\"fab fa-markdown\\\"></i> README</div>\\r\\n                        <div class=\\\"markdown-body\\\" v-html=\\\"renderMarkdown(openListReadme)\\\"></div>\\r\\n                    </div>\\r\\n                </div>\\r\\n            </div>\\r\\n        </div>\\r\\n\\r\\n\\r\\n        <!-- 2. 设置 -->\\r\\n        <div v-if=\\\"openListSubTab === 'settings'\\\" class=\\\"openlist-settings animate-fade-in\\\">\\r\\n            <div class=\\\"panel shadow-sm\\\" style=\\\"margin-bottom: 16px;\\\">\\r\\n                <div class=\\\"panel-header\\\" style=\\\"padding: 10px;\\\">\\r\\n                    <div class=\\\"panel-title\\\"><i class=\\\"fas fa-server text-primary\\\"></i> 实例管理</div>\\r\\n                </div>\\r\\n                <div style=\\\"padding: 0;\\\">\\r\\n                    <div v-for=\\\"acc in openListAccounts\\\" :key=\\\"acc.id\\\" class=\\\"setting-item\\\"\\r\\n                        style=\\\"display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px solid var(--border-color); gap: 12px;\\\">\\r\\n                        <div style=\\\"flex: 1; min-width: 0;\\\">\\r\\n                            <div style=\\\"display: flex; align-items: center; gap: 10px;\\\">\\r\\n                                <span :class=\\\"['status-dot', acc.status === 'online' ? 'online' : 'offline']\\\"></span>\\r\\n                                <span style=\\\"font-weight: 600; color: var(--text-primary); font-size: 14px;\\\">{{ acc.name\\r\\n                                    }}</span>\\r\\n                            </div>\\r\\n                            <div\\r\\n                                style=\\\"font-size: 12px; color: var(--text-tertiary); margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\\\">\\r\\n                                {{ acc.api_url }}</div>\\r\\n                        </div>\\r\\n                        <div style=\\\"display: flex; gap: 8px;\\\">\\r\\n                            <button class=\\\"btn btn-icon-refined sm\\\" @click=\\\"selectOpenListAccount(acc)\\\" title=\\\"使用此实例\\\"><i\\r\\n                                    class=\\\"fas fa-check\\\"></i></button>\\r\\n                            <button class=\\\"btn btn-icon-refined sm\\\" @click=\\\"testOpenListAccount(acc.id)\\\" title=\\\"连接测试\\\"><i\\r\\n                                    class=\\\"fas fa-plug\\\"></i></button>\\r\\n                            <button class=\\\"btn btn-icon-refined sm\\\" style=\\\"color: var(--danger-color);\\\"\\r\\n                                @click=\\\"deleteOpenListAccount(acc.id)\\\" title=\\\"删除\\\"><i\\r\\n                                    class=\\\"fas fa-trash-alt\\\"></i></button>\\r\\n                        </div>\\r\\n                    </div>\\r\\n                    <div class=\\\"setting-item\\\" style=\\\"padding: 10px;\\\">\\r\\n                        <div\\r\\n                            style=\\\"font-weight: 600; color: var(--text-primary); font-size: 14px; margin-bottom: 12px;\\\">\\r\\n                            <i class=\\\"fas fa-plus-circle text-primary\\\" style=\\\"margin-right: 6px;\\\"></i> 添加新实例\\r\\n                        </div>\\r\\n                        <div style=\\\"display: flex; gap: 12px; flex-wrap: wrap;\\\">\\r\\n                            <input type=\\\"text\\\" v-model=\\\"newOpenListAcc.name\\\" class=\\\"form-input\\\" placeholder=\\\"名称\\\"\\r\\n                                style=\\\"flex: 1; min-width: 100px;\\\" />\\r\\n                            <input type=\\\"text\\\" v-model=\\\"newOpenListAcc.api_url\\\" class=\\\"form-input\\\" placeholder=\\\"API 地址\\\"\\r\\n                                style=\\\"flex: 2; min-width: 200px;\\\" />\\r\\n                            <input type=\\\"password\\\" v-model=\\\"newOpenListAcc.api_token\\\" class=\\\"form-input\\\"\\r\\n                                placeholder=\\\"Token\\\" style=\\\"flex: 1; min-width: 120px;\\\" />\\r\\n                            <button class=\\\"btn btn-primary\\\" @click=\\\"doAddOpenListAccount\\\"><i class=\\\"fas fa-check\\\"></i>\\r\\n                                保存</button>\\r\\n                        </div>\\r\\n                    </div>\\r\\n                    <div v-if=\\\"openListAccounts.length === 0\\\" class=\\\"setting-item\\\"\\r\\n                        style=\\\"padding: 10px; text-align: center;\\\">\\r\\n                        <div style=\\\"color: var(--text-tertiary); font-size: 13px;\\\"><i class=\\\"fas fa-info-circle\\\"></i>\\r\\n                            暂无配置</div>\\r\\n                    </div>\\r\\n                </div>\\r\\n            </div>\\r\\n            <div class=\\\"panel shadow-sm\\\">\\r\\n                <div class=\\\"panel-header\\\" style=\\\"padding: 10px;\\\">\\r\\n                    <div class=\\\"panel-title\\\"><i class=\\\"fas fa-sliders-h text-primary\\\"></i> 偏好设置</div>\\r\\n                </div>\\r\\n                <div style=\\\"padding: 0;\\\">\\r\\n                    <div class=\\\"setting-item\\\"\\r\\n                        style=\\\"display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px solid var(--border-color);\\\">\\r\\n                        <div style=\\\"flex:1;\\\">\\r\\n                            <div style=\\\"font-weight: 600; color: var(--text-primary); font-size: 14px;\\\">自动刷新目录</div>\\r\\n                        </div>\\r\\n                        <label class=\\\"switch\\\"><input type=\\\"checkbox\\\" disabled checked><span\\r\\n                                class=\\\"slider round\\\"></span></label>\\r\\n                    </div>\\r\\n                    <div class=\\\"setting-item\\\"\\r\\n                        style=\\\"display: flex; justify-content: space-between; align-items: center; padding: 12px 16px;\\\">\\r\\n                        <input type=\\\"range\\\" class=\\\"form-range\\\" min=\\\"300\\\" max=\\\"1200\\\" step=\\\"50\\\"\\r\\n                            v-model=\\\"openListPreviewSize\\\" style=\\\"width: 120px;\\\">\\r\\n                        <button class=\\\"btn btn-secondary btn-sm\\\" @click=\\\"saveOpenListPreviewSize\\\">保存</button>\\r\\n                    </div>\\r\\n                </div>\\r\\n            </div>\\r\\n        </div>\\r\\n\\r\\n        <!-- 3. 定时任务 -->\\r\\n        <div v-if=\\\"openListSubTab === 'cron'\\\" class=\\\"cron-layout animate-fade-in\\\">\\r\\n            <!-- 任务列表卡片 -->\\r\\n            <div class=\\\"cron-card\\\">\\r\\n                <div class=\\\"cron-card-header\\\">\\r\\n                    <div class=\\\"cron-card-title\\\">\\r\\n                        <i class=\\\"fas fa-tasks\\\"></i>\\r\\n                        <span>任务列表</span>\\r\\n                        <span class=\\\"cron-badge\\\" v-if=\\\"cronTasks.length\\\">{{ cronTasks.length }}</span>\\r\\n                    </div>\\r\\n                    <button class=\\\"btn btn-primary btn-sm\\\" @click=\\\"openCronEditModal()\\\">\\r\\n                        <i class=\\\"fas fa-plus\\\"></i> 新建任务\\r\\n                    </button>\\r\\n                </div>\\r\\n                <div class=\\\"cron-card-body\\\">\\r\\n                    <!-- 任务列表 -->\\r\\n                    <div v-if=\\\"cronTasks.length > 0\\\" class=\\\"cron-task-list\\\">\\r\\n                        <div v-for=\\\"task in cronTasks\\\" :key=\\\"task.id\\\" class=\\\"cron-task-item\\\"\\r\\n                            :class=\\\"{ 'disabled': !task.enabled }\\\">\\r\\n                            <div class=\\\"cron-task-main\\\">\\r\\n                                <div class=\\\"cron-task-status\\\">\\r\\n                                    <span class=\\\"status-indicator\\\" :class=\\\"task.enabled ? 'active' : 'inactive'\\\"></span>\\r\\n                                </div>\\r\\n                                <div class=\\\"cron-task-info\\\">\\r\\n                                    <div class=\\\"cron-task-name\\\">{{ task.name }}</div>\\r\\n                                    <div class=\\\"cron-task-meta\\\">\\r\\n                                        <span class=\\\"cron-schedule\\\"><i class=\\\"fas fa-clock\\\"></i> {{ task.schedule\\r\\n                                            }}</span>\\r\\n                                        <span class=\\\"cron-type\\\"><i\\r\\n                                                :class=\\\"task.type === 'http' ? 'fas fa-globe' : 'fas fa-terminal'\\\"></i>\\r\\n                                            {{ task.type === 'http' ? 'HTTP' : 'Shell' }}</span>\\r\\n                                    </div>\\r\\n                                    <div class=\\\"cron-task-command\\\" :title=\\\"task.command\\\">{{ task.command }}</div>\\r\\n                                </div>\\r\\n                            </div>\\r\\n                            <div class=\\\"cron-task-extra\\\">\\r\\n                                <div class=\\\"cron-last-run\\\" v-if=\\\"task.last_run\\\">\\r\\n                                    <i class=\\\"fas fa-history\\\"></i> {{ formatDateTime(task.last_run * 1000) }}\\r\\n                                </div>\\r\\n                            </div>\\r\\n                            <div class=\\\"cron-task-actions\\\">\\r\\n                                <button class=\\\"btn btn-icon-refined sm\\\" @click=\\\"runCronTask(task)\\\" title=\\\"立即运行\\\">\\r\\n                                    <i class=\\\"fas fa-play\\\"></i>\\r\\n                                </button>\\r\\n                                <button class=\\\"btn btn-icon-refined sm\\\" @click=\\\"toggleCronTask(task)\\\"\\r\\n                                    :title=\\\"task.enabled ? '禁用' : '启用'\\\">\\r\\n                                    <i class=\\\"fas\\\" :class=\\\"task.enabled ? 'fa-pause' : 'fa-check'\\\"></i>\\r\\n                                </button>\\r\\n                                <button class=\\\"btn btn-icon-refined sm\\\" @click=\\\"openCronEditModal(task)\\\" title=\\\"编辑\\\">\\r\\n                                    <i class=\\\"fas fa-edit\\\"></i>\\r\\n                                </button>\\r\\n                                <button class=\\\"btn btn-icon-refined sm text-danger\\\" @click=\\\"deleteCronTask(task)\\\"\\r\\n                                    title=\\\"删除\\\">\\r\\n                                    <i class=\\\"fas fa-trash-alt\\\"></i>\\r\\n                                </button>\\r\\n                            </div>\\r\\n                        </div>\\r\\n                    </div>\\r\\n                    <!-- 空状态 -->\\r\\n                    <div v-else class=\\\"cron-empty-state\\\">\\r\\n                        <i class=\\\"fas fa-calendar-check\\\"></i>\\r\\n                        <p>暂无定时任务</p>\\r\\n                        <button class=\\\"btn btn-primary btn-sm\\\" @click=\\\"openCronEditModal()\\\">\\r\\n                            <i class=\\\"fas fa-plus\\\"></i> 创建第一个任务\\r\\n                        </button>\\r\\n                    </div>\\r\\n                </div>\\r\\n            </div>\\r\\n\\r\\n            <!-- 运行日志卡片 -->\\r\\n            <div class=\\\"cron-card\\\">\\r\\n                <div class=\\\"cron-card-header\\\">\\r\\n                    <div class=\\\"cron-card-title\\\">\\r\\n                        <i class=\\\"fas fa-history\\\"></i>\\r\\n                        <span>运行日志</span>\\r\\n                        <span class=\\\"cron-badge\\\" v-if=\\\"cronLogs.length\\\">{{ cronLogs.length }}</span>\\r\\n                    </div>\\r\\n                    <div class=\\\"cron-card-actions\\\">\\r\\n                        <button class=\\\"btn btn-icon-refined sm\\\" @click=\\\"loadCronLogs()\\\" title=\\\"刷新\\\">\\r\\n                            <i class=\\\"fas fa-sync-alt\\\"></i>\\r\\n                        </button>\\r\\n                        <button class=\\\"btn btn-icon-refined sm text-danger\\\" @click=\\\"clearCronLogs(7)\\\" title=\\\"清理7天前日志\\\">\\r\\n                            <i class=\\\"fas fa-trash\\\"></i>\\r\\n                        </button>\\r\\n                    </div>\\r\\n                </div>\\r\\n                <div class=\\\"cron-card-body cron-logs-container\\\">\\r\\n                    <!-- 日志列表 -->\\r\\n                    <div v-if=\\\"cronLogs.length > 0\\\" class=\\\"cron-log-list\\\">\\r\\n                        <div v-for=\\\"log in cronLogs\\\" :key=\\\"log.id\\\" class=\\\"cron-log-item\\\"\\r\\n                            :class=\\\"'status-' + log.status\\\">\\r\\n                            <div class=\\\"cron-log-header\\\">\\r\\n                                <span class=\\\"cron-log-time\\\"><i class=\\\"fas fa-clock\\\"></i> {{\\r\\n                                    formatDateTime(log.start_time * 1000) }}</span>\\r\\n                                <span class=\\\"cron-log-task\\\"><i class=\\\"fas fa-tag\\\"></i> {{ log.task_name || log.task_id\\r\\n                                    }}</span>\\r\\n                                <span class=\\\"cron-log-status\\\"\\r\\n                                    :class=\\\"'bg-' + (log.status === 'success' ? 'success' : (log.status === 'failed' ? 'danger' : 'warning'))\\\">\\r\\n                                    <i\\r\\n                                        :class=\\\"log.status === 'success' ? 'fas fa-check' : (log.status === 'failed' ? 'fas fa-times' : 'fas fa-spinner fa-spin')\\\"></i>\\r\\n                                    {{ log.status === 'success' ? '成功' : (log.status === 'failed' ? '失败' : '运行中') }}\\r\\n                                </span>\\r\\n                                <span class=\\\"cron-log-duration\\\" v-if=\\\"log.duration\\\"><i class=\\\"fas fa-stopwatch\\\"></i> {{\\r\\n                                    log.duration }}s</span>\\r\\n                            </div>\\r\\n                            <details class=\\\"cron-log-output\\\" v-if=\\\"log.output\\\">\\r\\n                                <summary><i class=\\\"fas fa-terminal\\\"></i> 查看输出</summary>\\r\\n                                <pre>{{ log.output }}</pre>\\r\\n                            </details>\\r\\n                        </div>\\r\\n                    </div>\\r\\n                    <!-- 空状态 -->\\r\\n                    <div v-else class=\\\"cron-empty-state compact\\\">\\r\\n                        <i class=\\\"fas fa-inbox\\\"></i>\\r\\n                        <p>暂无运行日志</p>\\r\\n                    </div>\\r\\n                </div>\\r\\n            </div>\\r\\n\\r\\n            <!-- 编辑/新建任务模态框 -->\\r\\n            <Teleport to=\\\"body\\\">\\r\\n                <div v-if=\\\"cronEditingTask\\\" class=\\\"modal-overlay\\\" @click.self=\\\"closeCronEditModal\\\">\\r\\n                    <div class=\\\"modal cron-modal\\\">\\r\\n                        <div class=\\\"modal-header\\\">\\r\\n                            <h5 class=\\\"modal-title\\\">\\r\\n                                <i :class=\\\"cronEditingTask.id ? 'fas fa-edit' : 'fas fa-plus-circle'\\\"></i>\\r\\n                                {{ cronEditingTask.id ? '编辑任务' : '新建任务' }}\\r\\n                            </h5>\\r\\n                            <button type=\\\"button\\\" class=\\\"modal-close\\\" @click=\\\"closeCronEditModal\\\">\\r\\n                                <i class=\\\"fas fa-times\\\"></i>\\r\\n                            </button>\\r\\n                        </div>\\r\\n                        <div class=\\\"modal-body\\\">\\r\\n                            <div class=\\\"form-group\\\">\\r\\n                                <label class=\\\"form-label\\\"><i class=\\\"fas fa-tag\\\"></i> 任务名称</label>\\r\\n                                <input type=\\\"text\\\" class=\\\"form-input\\\" v-model=\\\"cronEditingTask.name\\\"\\r\\n                                    placeholder=\\\"例如：每日备份\\\">\\r\\n                            </div>\\r\\n                            <div class=\\\"form-group\\\">\\r\\n                                <label class=\\\"form-label\\\"><i class=\\\"fas fa-clock\\\"></i> 执行周期</label>\\r\\n\\r\\n                                <!-- 简化设置 / 自定义 切换 -->\\r\\n                                <div style=\\\"display: flex; align-items: center; gap: 12px; margin-bottom: 10px;\\\">\\r\\n                                    <label\\r\\n                                        style=\\\"display: flex; align-items: center; gap: 6px; font-size: 13px; cursor: pointer;\\\">\\r\\n                                        <input type=\\\"checkbox\\\" v-model=\\\"cronEditingTask.useCustom\\\">\\r\\n                                        <span>自定义 Cron 表达式</span>\\r\\n                                    </label>\\r\\n                                </div>\\r\\n\\r\\n                                <!-- 简化设置模式 -->\\r\\n                                <div v-if=\\\"!cronEditingTask.useCustom\\\" class=\\\"cron-simple-builder\\\">\\r\\n                                    <div\\r\\n                                        style=\\\"display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 12px;\\\">\\r\\n                                        <!-- 周期类型 -->\\r\\n                                        <select v-model=\\\"cronEditingTask.periodType\\\" class=\\\"form-input\\\"\\r\\n                                            style=\\\"width: 100px;\\\" @change=\\\"updateCronFromSimple\\\">\\r\\n                                            <option value=\\\"minute\\\">每分钟</option>\\r\\n                                            <option value=\\\"hour\\\">每小时</option>\\r\\n                                            <option value=\\\"day\\\">每天</option>\\r\\n                                            <option value=\\\"week\\\">每周</option>\\r\\n                                            <option value=\\\"month\\\">每月</option>\\r\\n                                        </select>\\r\\n\\r\\n                                        <!-- 周几选择 (仅每周) -->\\r\\n                                        <select v-if=\\\"cronEditingTask.periodType === 'week'\\\"\\r\\n                                            v-model=\\\"cronEditingTask.weekday\\\" class=\\\"form-input\\\" style=\\\"width: 80px;\\\"\\r\\n                                            @change=\\\"updateCronFromSimple\\\">\\r\\n                                            <option value=\\\"1\\\">周一</option>\\r\\n                                            <option value=\\\"2\\\">周二</option>\\r\\n                                            <option value=\\\"3\\\">周三</option>\\r\\n                                            <option value=\\\"4\\\">周四</option>\\r\\n                                            <option value=\\\"5\\\">周五</option>\\r\\n                                            <option value=\\\"6\\\">周六</option>\\r\\n                                            <option value=\\\"0\\\">周日</option>\\r\\n                                        </select>\\r\\n\\r\\n                                        <!-- 日期选择 (仅每月) -->\\r\\n                                        <select v-if=\\\"cronEditingTask.periodType === 'month'\\\"\\r\\n                                            v-model=\\\"cronEditingTask.dayOfMonth\\\" class=\\\"form-input\\\" style=\\\"width: 80px;\\\"\\r\\n                                            @change=\\\"updateCronFromSimple\\\">\\r\\n                                            <option v-for=\\\"d in 31\\\" :key=\\\"d\\\" :value=\\\"d\\\">{{ d }}日</option>\\r\\n                                        </select>\\r\\n\\r\\n                                        <!-- 时间选择 (每天/每周/每月) -->\\r\\n                                        <template v-if=\\\"['day', 'week', 'month'].includes(cronEditingTask.periodType)\\\">\\r\\n                                            <input type=\\\"number\\\" v-model.number=\\\"cronEditingTask.hour\\\" min=\\\"0\\\" max=\\\"23\\\"\\r\\n                                                class=\\\"form-input\\\" style=\\\"width: 60px; text-align: center;\\\"\\r\\n                                                @change=\\\"updateCronFromSimple\\\">\\r\\n                                            <span style=\\\"font-size: 13px;\\\">时</span>\\r\\n                                            <input type=\\\"number\\\" v-model.number=\\\"cronEditingTask.minute\\\" min=\\\"0\\\"\\r\\n                                                max=\\\"59\\\" class=\\\"form-input\\\" style=\\\"width: 60px; text-align: center;\\\"\\r\\n                                                @change=\\\"updateCronFromSimple\\\">\\r\\n                                            <span style=\\\"font-size: 13px;\\\">分</span>\\r\\n                                        </template>\\r\\n\\r\\n                                        <!-- 分钟选择 (每小时) -->\\r\\n                                        <template v-if=\\\"cronEditingTask.periodType === 'hour'\\\">\\r\\n                                            <span style=\\\"font-size: 13px;\\\">第</span>\\r\\n                                            <input type=\\\"number\\\" v-model.number=\\\"cronEditingTask.minute\\\" min=\\\"0\\\"\\r\\n                                                max=\\\"59\\\" class=\\\"form-input\\\" style=\\\"width: 60px; text-align: center;\\\"\\r\\n                                                @change=\\\"updateCronFromSimple\\\">\\r\\n                                            <span style=\\\"font-size: 13px;\\\">分钟</span>\\r\\n                                        </template>\\r\\n\\r\\n                                        <!-- 预览链接 -->\\r\\n                                        <a href=\\\"javascript:;\\\" @click=\\\"previewCronSchedule\\\"\\r\\n                                            style=\\\"color: var(--primary-color); font-size: 13px; text-decoration: none;\\\">\\r\\n                                            <i class=\\\"fas fa-eye\\\"></i> 预览\\r\\n                                        </a>\\r\\n                                    </div>\\r\\n\\r\\n                                    <!-- 生成的 Cron 表达式显示 -->\\r\\n                                    <div\\r\\n                                        style=\\\"font-size: 12px; color: var(--text-secondary); background: var(--bg-tertiary); padding: 6px 10px; border-radius: 6px;\\\">\\r\\n                                        <i class=\\\"fas fa-info-circle\\\"></i> 表达式: <code\\r\\n                                            style=\\\"font-family: var(--font-mono); color: var(--primary-color);\\\">{{ cronEditingTask.schedule || '* * * * *' }}</code>\\r\\n                                    </div>\\r\\n                                </div>\\r\\n\\r\\n                                <!-- 自定义 Cron 表达式模式 -->\\r\\n                                <div v-else class=\\\"cron-schedule-input\\\">\\r\\n                                    <input type=\\\"text\\\" class=\\\"form-input font-mono\\\" v-model=\\\"cronEditingTask.schedule\\\"\\r\\n                                        placeholder=\\\"* * * * *\\\">\\r\\n                                    <a href=\\\"https://crontab.guru/\\\" target=\\\"_blank\\\" class=\\\"btn btn-secondary btn-sm\\\"\\r\\n                                        title=\\\"Crontab Guru\\\">\\r\\n                                        <i class=\\\"fas fa-question-circle\\\"></i>\\r\\n                                    </a>\\r\\n                                </div>\\r\\n                                <div class=\\\"form-help\\\" v-if=\\\"cronEditingTask.useCustom\\\">格式：分 时 日 月 周</div>\\r\\n\\r\\n                                <!-- 预览未来执行时间 -->\\r\\n                                <div v-if=\\\"cronEditingTask.nextRuns && cronEditingTask.nextRuns.length > 0\\\"\\r\\n                                    style=\\\"margin-top: 12px;\\\">\\r\\n                                    <div\\r\\n                                        style=\\\"font-size: 12px; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);\\\">\\r\\n                                        <i class=\\\"fas fa-calendar-alt\\\"></i> 近 5 次执行\\r\\n                                    </div>\\r\\n                                    <div style=\\\"display: flex; flex-direction: column; gap: 4px;\\\">\\r\\n                                        <div v-for=\\\"(run, idx) in cronEditingTask.nextRuns\\\" :key=\\\"idx\\\"\\r\\n                                            style=\\\"font-size: 12px; padding: 4px 10px; background: rgba(var(--primary-rgb), 0.1); border-radius: 4px; color: var(--primary-color); border: 1px solid rgba(var(--primary-rgb), 0.2);\\\">\\r\\n                                            {{ run }}\\r\\n                                        </div>\\r\\n                                    </div>\\r\\n                                </div>\\r\\n                            </div>\\r\\n                            <div class=\\\"form-group\\\">\\r\\n                                <label class=\\\"form-label\\\"><i class=\\\"fas fa-cog\\\"></i> 任务类型</label>\\r\\n                                <div class=\\\"cron-type-selector\\\">\\r\\n                                    <label class=\\\"cron-type-option\\\"\\r\\n                                        :class=\\\"{ active: cronEditingTask.type === 'shell' }\\\">\\r\\n                                        <input type=\\\"radio\\\" v-model=\\\"cronEditingTask.type\\\" value=\\\"shell\\\">\\r\\n                                        <i class=\\\"fas fa-terminal\\\"></i>\\r\\n                                        <span>Shell 命令</span>\\r\\n                                    </label>\\r\\n                                    <label class=\\\"cron-type-option\\\"\\r\\n                                        :class=\\\"{ active: cronEditingTask.type === 'http' }\\\">\\r\\n                                        <input type=\\\"radio\\\" v-model=\\\"cronEditingTask.type\\\" value=\\\"http\\\">\\r\\n                                        <i class=\\\"fas fa-globe\\\"></i>\\r\\n                                        <span>HTTP 请求</span>\\r\\n                                    </label>\\r\\n                                </div>\\r\\n                            </div>\\r\\n                            <div class=\\\"form-group\\\">\\r\\n                                <label class=\\\"form-label\\\">\\r\\n                                    <i :class=\\\"cronEditingTask.type === 'http' ? 'fas fa-link' : 'fas fa-code'\\\"></i>\\r\\n                                    {{ cronEditingTask.type === 'http' ? 'URL 地址' : '命令内容' }}\\r\\n                                </label>\\r\\n                                <textarea class=\\\"form-input font-mono\\\" v-model=\\\"cronEditingTask.command\\\" rows=\\\"3\\\"\\r\\n                                    :placeholder=\\\"cronEditingTask.type === 'http' ? 'https://example.com/api/cron' : 'echo hello'\\\"></textarea>\\r\\n                            </div>\\r\\n                            <div class=\\\"form-group\\\">\\r\\n                                <label class=\\\"cron-enable-toggle\\\">\\r\\n                                    <input type=\\\"checkbox\\\" v-model=\\\"cronEditingTask.enabled\\\" :true-value=\\\"1\\\"\\r\\n                                        :false-value=\\\"0\\\">\\r\\n                                    <span class=\\\"toggle-switch\\\"></span>\\r\\n                                    <span class=\\\"toggle-label\\\">启用此任务</span>\\r\\n                                </label>\\r\\n                            </div>\\r\\n                        </div>\\r\\n                        <div class=\\\"modal-footer\\\">\\r\\n                            <button type=\\\"button\\\" class=\\\"btn btn-secondary\\\" @click=\\\"closeCronEditModal\\\">取消</button>\\r\\n                            <button type=\\\"button\\\" class=\\\"btn btn-primary\\\" @click=\\\"saveCronTask\\\">\\r\\n                                <i class=\\\"fas fa-check\\\"></i> 保存\\r\\n                            </button>\\r\\n                        </div>\\r\\n                    </div>\\r\\n                </div>\\r\\n            </Teleport>\\r\\n        </div>\\r\\n\\r\\n        <!-- 4. 临时标签页 -->\\r\\n        <div v-for=\\\"tab in openListTempTabs\\\" :key=\\\"tab.id\\\"\\r\\n            v-show=\\\"openListSubTab === 'temp' && tab.id === openListActiveTempTabId\\\"\\r\\n            class=\\\"openlist-files-layout animate-fade-in\\\" :class=\\\"{ 'video-mode-layout': tab.isVideo }\\\">\\r\\n            <!-- 视频播放模式 - 使用 Plyr -->\\r\\n            <div v-if=\\\"tab.isVideo\\\" class=\\\"openlist-video-tab-view\\\">\\r\\n                <div class=\\\"plyr-player-wrapper\\\">\\r\\n                    <!-- 顶部操作栏 -->\\r\\n                    <div class=\\\"plyr-player-toolbar\\\">\\r\\n                        <div class=\\\"plyr-toolbar-title\\\">\\r\\n                            <i class=\\\"fas fa-film\\\"></i>\\r\\n                            <span>{{ tab.name }}</span>\\r\\n                        </div>\\r\\n                        <div class=\\\"plyr-toolbar-actions\\\">\\r\\n                            <button class=\\\"btn btn-icon-refined\\\" @click=\\\"openExternalPlayer\\\"\\r\\n                                title=\\\"外部播放 (PC: PotPlayer / 手机: UC浏览器)\\\">\\r\\n                                <i class=\\\"fas fa-play-circle\\\"></i>\\r\\n                            </button>\\r\\n                            <button class=\\\"btn btn-icon-refined\\\" @click=\\\"openVideoInNewTab\\\" title=\\\"在浏览器新标签页打开\\\">\\r\\n                                <i class=\\\"fas fa-external-link-alt\\\"></i>\\r\\n                            </button>\\r\\n                            <button class=\\\"btn btn-icon-refined\\\" @click=\\\"closeOpenListTempTab(tab.id)\\\" title=\\\"关闭标签页\\\">\\r\\n                                <i class=\\\"fas fa-times\\\"></i>\\r\\n                            </button>\\r\\n                        </div>\\r\\n                    </div>\\r\\n                    <!-- Plyr 视频元素 -->\\r\\n                    <video :id=\\\"'plyr-video-' + tab.id\\\" class=\\\"plyr-video\\\" playsinline></video>\\r\\n                </div>\\r\\n            </div>\\r\\n\\r\\n            <!-- 普通文件列表模式 -->\\r\\n            <div v-else class=\\\"openlist-main-view\\\">\\r\\n                <div class=\\\"openlist-toolbar-standalone\\\">\\r\\n                    <div class=\\\"toolbar-left\\\">\\r\\n                        <div class=\\\"breadcrumb-fluid-container\\\">\\r\\n                            <button class=\\\"bc-node\\\" @click=\\\"loadTempTabFiles('/')\\\"><i class=\\\"fas fa-home\\\"></i></button>\\r\\n                            <template v-for=\\\"(part, index) in openListTempPathParts\\\" :key=\\\"part.path\\\">\\r\\n                                <i class=\\\"fas fa-chevron-right bc-divider\\\"></i>\\r\\n                                <button class=\\\"bc-node\\\"\\r\\n                                    :class=\\\"{ 'active': index === openListTempPathParts.length - 1 }\\\"\\r\\n                                    @click=\\\"loadTempTabFiles(part.path)\\\">{{ part.name }}</button>\\r\\n                            </template>\\r\\n                        </div>\\r\\n                    </div>\\r\\n                    <div class=\\\"toolbar-right\\\">\\r\\n                        <button class=\\\"btn btn-icon-refined\\\" @click=\\\"loadTempTabFiles(tab.path, true)\\\"><i\\r\\n                                class=\\\"fas fa-sync-alt\\\"></i></button>\\r\\n                        <button class=\\\"btn btn-secondary btn-sm\\\" @click=\\\"mergeToMainTab\\\">\\r\\n                            <i class=\\\"fas fa-layer-group\\\"></i> <span>合并到主列表</span>\\r\\n                        </button>\\r\\n                    </div>\\r\\n                </div>\\r\\n                <div class=\\\"openlist-list-container\\\">\\r\\n                    <table class=\\\"data-table sticky-header\\\" style=\\\"width: 100%;\\\">\\r\\n                        <thead>\\r\\n                            <tr>\\r\\n                                <th class=\\\"col-name\\\">名称</th>\\r\\n                                <th class=\\\"col-size\\\">大小</th>\\r\\n                                <th class=\\\"col-time hide-on-mobile\\\">修改时间</th>\\r\\n                            </tr>\\r\\n                        </thead>\\r\\n                        <tbody v-if=\\\"tab.files.length > 0\\\">\\r\\n                            <tr v-for=\\\"file in tab.files\\\" :key=\\\"file.name\\\" @click=\\\"handleTempTabFile(file)\\\"\\r\\n                                @contextmenu=\\\"showFileContextMenu($event, file, tab.path)\\\"\\r\\n                                @touchstart=\\\"handleFileTouchStart($event, file, tab.path)\\\"\\r\\n                                @touchend=\\\"handleFileTouchEnd($event)\\\" @touchmove=\\\"handleFileTouchMove()\\\"\\r\\n                                @auxclick.middle.stop=\\\"handleMiddleClickItem(file)\\\">\\r\\n                                <td class=\\\"col-name\\\">\\r\\n                                    <div class=\\\"file-cell-main\\\">\\r\\n                                        <div class=\\\"file-icon-wrapper\\\"><i :class=\\\"getFileIconClass(file)\\\"></i></div>\\r\\n                                        <span class=\\\"file-name-text\\\">{{ file.name }}</span>\\r\\n                                    </div>\\r\\n                                </td>\\r\\n                                <td class=\\\"col-size font-mono text-secondary\\\">{{ getOpenListFileSize(file) || '-' }}\\r\\n                                </td>\\r\\n                                <td class=\\\"col-time text-tertiary hide-on-mobile\\\">{{ formatDateTime(file.modified) }}\\r\\n                                </td>\\r\\n                            </tr>\\r\\n                        </tbody>\\r\\n                        <tbody v-else-if=\\\"!tab.loading\\\">\\r\\n                            <tr>\\r\\n                                <td colspan=\\\"3\\\" style=\\\"text-align:center; padding: 20px;\\\">目录为空</td>\\r\\n                            </tr>\\r\\n                        </tbody>\\r\\n                    </table>\\r\\n                </div>\\r\\n            </div>\\r\\n        </div>\\r\\n    </div>\\r\\n</div>\\r\\n\\r\\n<!-- 悬停预览图容器 -->\\r\\n<div id=\\\"file-hover-preview\\\" class=\\\"file-hover-preview\\\">\\r\\n    <img id=\\\"file-hover-img\\\" src=\\\"\\\" referrerpolicy=\\\"no-referrer\\\" />\\r\\n</div>\\r\\n\\r\\n<!-- 文件右键菜单 -->\\r\\n<Teleport to=\\\"body\\\">\\r\\n    <div v-if=\\\"openListContextMenu.visible\\\" class=\\\"openlist-context-menu\\\"\\r\\n        :style=\\\"{ left: openListContextMenu.x + 'px', top: openListContextMenu.y + 'px' }\\\" @click.stop>\\r\\n        <div class=\\\"context-menu-item\\\" @click=\\\"handleFileContextAction('open')\\\">\\r\\n            <i class=\\\"fas fa-folder-open\\\"></i>\\r\\n            <span>{{ openListContextMenu.file?.is_dir ? '打开' : '查看详情' }}</span>\\r\\n        </div>\\r\\n        <div v-if=\\\"openListContextMenu.file?.is_dir\\\" class=\\\"context-menu-item\\\"\\r\\n            @click=\\\"handleFileContextAction('open-new-tab')\\\">\\r\\n            <i class=\\\"fas fa-external-link-alt\\\"></i>\\r\\n            <span>在新标签页打开</span>\\r\\n        </div>\\r\\n        <div v-if=\\\"!openListContextMenu.file?.is_dir\\\" class=\\\"context-menu-item\\\"\\r\\n            @click=\\\"handleFileContextAction('download')\\\">\\r\\n            <i class=\\\"fas fa-download\\\"></i>\\r\\n            <span>下载</span>\\r\\n        </div>\\r\\n        <div class=\\\"context-menu-divider\\\"></div>\\r\\n        <div class=\\\"context-menu-item\\\" @click=\\\"handleFileContextAction('rename')\\\">\\r\\n            <i class=\\\"fas fa-edit\\\"></i>\\r\\n            <span>重命名</span>\\r\\n        </div>\\r\\n        <div class=\\\"context-menu-item danger\\\" @click=\\\"handleFileContextAction('delete')\\\">\\r\\n            <i class=\\\"fas fa-trash-alt\\\"></i>\\r\\n            <span>删除</span>\\r\\n        </div>\\r\\n</Teleport>\\r\\n\\r\\n<!-- 图片预览弹窗 -->\\r\\n<Teleport to=\\\"body\\\">\\r\\n    <div v-if=\\\"imagePreview.visible\\\" class=\\\"image-preview-overlay\\\" @click.self=\\\"closeImagePreview\\\">\\r\\n        <div class=\\\"image-preview-container\\\">\\r\\n            <!-- 关闭按钮 -->\\r\\n            <button class=\\\"image-preview-close\\\" @click=\\\"closeImagePreview\\\" title=\\\"关闭 (ESC)\\\">\\r\\n                <i class=\\\"fas fa-times\\\"></i>\\r\\n            </button>\\r\\n\\r\\n            <!-- 图片标题栏 -->\\r\\n            <div class=\\\"image-preview-header\\\">\\r\\n                <span class=\\\"image-preview-filename\\\" :title=\\\"imagePreview.filename\\\">{{ imagePreview.filename }}</span>\\r\\n                <div class=\\\"image-preview-actions\\\">\\r\\n                    <a :href=\\\"imagePreview.url\\\" target=\\\"_blank\\\" class=\\\"btn btn-icon-refined sm\\\" title=\\\"在新标签页打开\\\"\\r\\n                        rel=\\\"noopener noreferrer\\\">\\r\\n                        <i class=\\\"fas fa-external-link-alt\\\"></i>\\r\\n                    </a>\\r\\n                    <button @click=\\\"downloadImageInPreview\\\" class=\\\"btn btn-icon-refined sm\\\" title=\\\"下载到本地\\\">\\r\\n                        <i class=\\\"fas fa-download\\\"></i>\\r\\n                    </button>\\r\\n                </div>\\r\\n            </div>\\r\\n\\r\\n            <!-- 图片内容 -->\\r\\n            <div class=\\\"image-preview-body\\\">\\r\\n                <!-- 加载中遮罩 -->\\r\\n                <div v-show=\\\"imagePreview.loading\\\" class=\\\"image-preview-loading\\\">\\r\\n                    <i class=\\\"fas fa-spinner fa-spin\\\"></i>\\r\\n                    <span>加载中...</span>\\r\\n                </div>\\r\\n                <!-- 图片 -->\\r\\n                <img v-show=\\\"!imagePreview.loading\\\" :src=\\\"imagePreview.url\\\" :alt=\\\"imagePreview.filename\\\"\\r\\n                    class=\\\"image-preview-img\\\" @load=\\\"onImagePreviewLoad\\\" @error=\\\"onImagePreviewError\\\"\\r\\n                    referrerpolicy=\\\"no-referrer\\\" draggable=\\\"false\\\" />\\r\\n            </div>\\r\\n        </div>\\r\\n    </div>\\r\\n</Teleport>\"\n//# sourceMappingURL=data:application/json;base64,"
