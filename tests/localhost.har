            "compression": 0,
            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/css/logs.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"E:/Code/api-monitor/src/css/logs.css\"\nconst __vite__css = \"/* 统一日志查看器样式 */\\r\\n\\r\\n/* 模态框遮罩层 (高优先级) */\\r\\n.log-viewer-overlay {\\r\\n    z-index: 2200 !important;\\r\\n    /* 高于设置页面(2001) */\\r\\n}\\r\\n\\r\\n/* 模态框容器 */\\r\\n.log-viewer-modal {\\r\\n    width: 900px;\\r\\n    height: 620px;\\r\\n    max-width: 95vw;\\r\\n    max-height: 92vh;\\r\\n    background-color: var(--card-bg);\\r\\n    color: var(--text-primary);\\r\\n    display: flex;\\r\\n    flex-direction: column;\\r\\n    /* border-radius: 24px; */\\r\\n    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.5);\\r\\n    overflow: hidden;\\r\\n    border: 1px solid var(--border-color);\\r\\n    font-family: var(--font-main);\\r\\n    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);\\r\\n    position: relative;\\r\\n    /* 极致圆角裁剪：解决部分浏览器背景色溢出 parent 边框的问题 */\\r\\n    -webkit-mask-image: -webkit-radial-gradient(white, black);\\r\\n    mask-image: radial-gradient(white, black);\\r\\n}\\r\\n\\r\\n/* 覆盖 .modal-lg 和 .modal 的 max-width */\\r\\n.modal.log-viewer-modal {\\r\\n    max-width: 900px;\\r\\n}\\r\\n\\r\\n.log-viewer-modal.fullscreen {\\r\\n    width: 100vw;\\r\\n    height: 100vh;\\r\\n    max-width: 100vw;\\r\\n    max-height: 100vh;\\r\\n    border-radius: 0;\\r\\n    border: none;\\r\\n}\\r\\n\\r\\n/* 顶栏 */\\r\\n.log-header {\\r\\n    height: 50px;\\r\\n    background-color: var(--bg-secondary);\\r\\n    backdrop-filter: blur(15px);\\r\\n    -webkit-backdrop-filter: blur(15px);\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    justify-content: space-between;\\r\\n    padding: 0 5px;\\r\\n    border-bottom: 1px solid var(--border-color);\\r\\n    flex-shrink: 0;\\r\\n}\\r\\n\\r\\n.log-title-group {\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    gap: 12px;\\r\\n}\\r\\n\\r\\n.log-icon {\\r\\n    width: 32px;\\r\\n    height: 32px;\\r\\n    background: var(--primary-color);\\r\\n    color: white;\\r\\n    border-radius: 8px;\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    justify-content: center;\\r\\n    font-size: 16px;\\r\\n    box-shadow: 0 2px 6px rgba(var(--primary-rgb), 0.3);\\r\\n}\\r\\n\\r\\n.log-info {\\r\\n    gap: 8px;\\r\\n    display: flex;\\r\\n    flex-direction: row;\\r\\n    justify-content: center;\\r\\n    /* align-items: flex-end; */\\r\\n}\\r\\n\\r\\n.log-title {\\r\\n    font-size: 15px;\\r\\n    font-weight: 700;\\r\\n    color: var(--text-primary);\\r\\n}\\r\\n\\r\\n.log-subtitle {\\r\\n    font-size: 12px;\\r\\n    color: var(--text-tertiary);\\r\\n    margin-top: 1px;\\r\\n}\\r\\n\\r\\n.log-status-badge {\\r\\n    padding: 2px 10px;\\r\\n    border-radius: 20px;\\r\\n    font-size: 10px;\\r\\n    font-weight: 800;\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    gap: 6px;\\r\\n    text-transform: uppercase;\\r\\n    background: var(--bg-tertiary);\\r\\n    color: var(--text-tertiary);\\r\\n    letter-spacing: 0.5px;\\r\\n}\\r\\n\\r\\n.log-status-badge.live {\\r\\n    background: rgba(16, 185, 129, 0.1);\\r\\n    color: var(--success-color);\\r\\n}\\r\\n\\r\\n.log-status-badge.live .dot {\\r\\n    width: 6px;\\r\\n    height: 6px;\\r\\n    border-radius: 50%;\\r\\n    background: #10b981;\\r\\n    box-shadow: 0 0 8px #10b981;\\r\\n    animation: log-pulse 2s infinite;\\r\\n}\\r\\n\\r\\n@keyframes log-pulse {\\r\\n    0% {\\r\\n        transform: scale(1);\\r\\n        opacity: 1;\\r\\n    }\\r\\n\\r\\n    50% {\\r\\n        transform: scale(1.5);\\r\\n        opacity: 0.5;\\r\\n    }\\r\\n\\r\\n    100% {\\r\\n        transform: scale(1);\\r\\n        opacity: 1;\\r\\n    }\\r\\n}\\r\\n\\r\\n/* 窗口控制按钮 */\\r\\n.log-window-controls {\\r\\n    display: flex;\\r\\n    gap: 8px;\\r\\n}\\r\\n\\r\\n.win-btn {\\r\\n    width: 28px;\\r\\n    height: 28px;\\r\\n    border: none;\\r\\n    background: transparent;\\r\\n    color: #888;\\r\\n    border-radius: 4px;\\r\\n    cursor: pointer;\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    justify-content: center;\\r\\n    transition: all 0.2s;\\r\\n}\\r\\n\\r\\n.win-btn:hover {\\r\\n    background: #3c3c3c;\\r\\n    color: #fff;\\r\\n}\\r\\n\\r\\n.win-btn.close:hover {\\r\\n    background: #c42b1c;\\r\\n}\\r\\n\\r\\n/* 工具栏 */\\r\\n.log-toolbar {\\r\\n    min-height: 52px;\\r\\n    background-color: var(--bg-primary);\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    justify-content: space-between;\\r\\n    padding: 8px 16px;\\r\\n    border-bottom: 1px solid var(--border-color);\\r\\n    flex-shrink: 0;\\r\\n    flex-wrap: wrap;\\r\\n    gap: 12px;\\r\\n}\\r\\n\\r\\n.log-filters {\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    gap: 8px;\\r\\n}\\r\\n\\r\\n.search-box {\\r\\n    position: relative;\\r\\n    width: 230px;\\r\\n    max-width: 100%;\\r\\n}\\r\\n\\r\\n.search-box i {\\r\\n    position: absolute;\\r\\n    left: 10px;\\r\\n    top: 50%;\\r\\n    transform: translateY(-50%);\\r\\n    color: #888;\\r\\n    font-size: 13px;\\r\\n}\\r\\n\\r\\n.search-box input {\\r\\n    width: 100%;\\r\\n    height: 32px;\\r\\n    background: var(--bg-secondary);\\r\\n    border: 1px solid var(--border-color);\\r\\n    border-radius: 16px;\\r\\n    padding: 0 30px 0 36px;\\r\\n    color: var(--text-primary);\\r\\n    font-size: 13px;\\r\\n    outline: none;\\r\\n    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\\r\\n}\\r\\n\\r\\n.search-box input:focus {\\r\\n    border-color: var(--primary-color);\\r\\n    background: var(--card-bg);\\r\\n    box-shadow: 0 0 0 3px rgba(var(--primary-rgb), 0.15);\\r\\n}\\r\\n\\r\\n.clear-search {\\r\\n    position: absolute;\\r\\n    right: 4px;\\r\\n    top: 50%;\\r\\n    transform: translateY(-50%);\\r\\n    background: none;\\r\\n    border: none;\\r\\n    color: #666;\\r\\n    cursor: pointer;\\r\\n    padding: 2px;\\r\\n}\\r\\n\\r\\n.clear-search:hover {\\r\\n    color: #ccc;\\r\\n}\\r\\n\\r\\n.level-select {\\r\\n    height: 32px;\\r\\n    background: var(--bg-secondary);\\r\\n    border: 1px solid var(--border-color);\\r\\n    color: var(--text-primary);\\r\\n    border-radius: 8px;\\r\\n    padding: 0 12px;\\r\\n    font-size: 12px;\\r\\n    outline: none;\\r\\n    cursor: pointer;\\r\\n    transition: all 0.2s;\\r\\n}\\r\\n\\r\\n.level-select:hover {\\r\\n    border-color: var(--primary-color);\\r\\n}\\r\\n\\r\\n.log-actions {\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    gap: 8px;\\r\\n    flex-wrap: wrap;\\r\\n}\\r\\n\\r\\n.tool-btn {\\r\\n    height: 32px;\\r\\n    padding: 0 14px;\\r\\n    background: var(--bg-secondary);\\r\\n    border: 1px solid var(--border-color);\\r\\n    color: var(--text-secondary);\\r\\n    border-radius: 8px;\\r\\n    cursor: pointer;\\r\\n    font-size: 12px;\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    gap: 8px;\\r\\n    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\\r\\n    font-weight: 500;\\r\\n}\\r\\n\\r\\n.tool-btn:hover {\\r\\n    background: var(--bg-tertiary);\\r\\n    border-color: var(--text-tertiary);\\r\\n    color: var(--text-primary);\\r\\n}\\r\\n\\r\\n.tool-btn.active {\\r\\n    background: var(--primary-color);\\r\\n    color: #fff;\\r\\n    border-color: var(--primary-color);\\r\\n    box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.3);\\r\\n}\\r\\n\\r\\n.divider {\\r\\n    width: 1px;\\r\\n    height: 20px;\\r\\n    background-color: var(--border-color);\\r\\n    margin: 0 4px;\\r\\n}\\r\\n\\r\\n.tool-btn i {\\r\\n    font-size: 13px;\\r\\n}\\r\\n\\r\\n.divider {\\r\\n    width: 1px;\\r\\n    height: 16px;\\r\\n    background: #444;\\r\\n    margin: 0 4px;\\r\\n}\\r\\n\\r\\n/* 日志可视区域 */\\r\\n.log-viewport {\\r\\n    flex: 1;\\r\\n    overflow-y: auto;\\r\\n    overflow-x: auto;\\r\\n    -webkit-overflow-scrolling: touch;\\r\\n    background-color: var(--bg-primary);\\r\\n    padding: 16px 0;\\r\\n    position: relative;\\r\\n    scroll-behavior: smooth;\\r\\n    overscroll-behavior-x: contain;\\r\\n    /* 自定义滚动条 */\\r\\n    scrollbar-width: thin;\\r\\n    scrollbar-color: var(--border-color) var(--bg-primary);\\r\\n}\\r\\n\\r\\n.log-viewport::-webkit-scrollbar {\\r\\n    display: block !important;\\r\\n    width: 8px;\\r\\n    height: 8px;\\r\\n}\\r\\n\\r\\n.log-viewport::-webkit-scrollbar-track {\\r\\n    background: var(--bg-primary);\\r\\n}\\r\\n\\r\\n.log-viewport::-webkit-scrollbar-thumb {\\r\\n    background-color: var(--border-color);\\r\\n    border: 2px solid var(--bg-primary);\\r\\n    border-radius: 10px;\\r\\n}\\r\\n\\r\\n.log-viewport::-webkit-scrollbar-thumb:hover {\\r\\n    background-color: var(--text-tertiary);\\r\\n}\\r\\n\\r\\n.log-viewport.wrap-text .message {\\r\\n    white-space: pre-wrap;\\r\\n    word-break: break-all;\\r\\n    min-width: 0;\\r\\n}\\r\\n\\r\\n.log-viewport:not(.wrap-text) .log-lines {\\r\\n    width: max-content;\\r\\n    min-width: 100%;\\r\\n}\\r\\n\\r\\n.log-viewport:not(.wrap-text) .log-entry {\\r\\n    width: max-content;\\r\\n    min-width: 100%;\\r\\n}\\r\\n\\r\\n.log-loading,\\r\\n.log-empty {\\r\\n    height: 100%;\\r\\n    display: flex;\\r\\n    flex-direction: column;\\r\\n    align-items: center;\\r\\n    justify-content: center;\\r\\n    color: #666;\\r\\n    gap: 12px;\\r\\n    padding: 40px;\\r\\n}\\r\\n\\r\\n.log-empty i {\\r\\n    font-size: 48px;\\r\\n    opacity: 0.5;\\r\\n}\\r\\n\\r\\n.log-entry {\\r\\n    display: flex;\\r\\n    flex-direction: row;\\r\\n    align-items: flex-start;\\r\\n    justify-content: flex-start;\\r\\n    padding: 2px 0px;\\r\\n    font-size: 13px;\\r\\n    line-height: 1.6;\\r\\n    transition: background 0.1s;\\r\\n    border-left: 3px solid transparent;\\r\\n    gap: 0;\\r\\n    flex-wrap: nowrap;\\r\\n    /* 禁止换行 */\\r\\n}\\r\\n\\r\\n.log-entry:hover {\\r\\n    background: rgba(var(--primary-rgb), 0.05);\\r\\n}\\r\\n\\r\\n.log-entry.error {\\r\\n    color: var(--danger-color);\\r\\n    background: rgba(239, 68, 68, 0.08);\\r\\n    /* border-left-color: var(--danger-color); */\\r\\n}\\r\\n\\r\\n.log-entry.warn {\\r\\n    color: var(--warning-color);\\r\\n    background: rgba(245, 158, 11, 0.05);\\r\\n    border-left-color: var(--warning-color);\\r\\n}\\r\\n\\r\\n.log-entry.debug {\\r\\n    color: var(--text-tertiary);\\r\\n    opacity: 0.8;\\r\\n}\\r\\n\\r\\n.log-entry .line-num {\\r\\n    color: var(--text-tertiary);\\r\\n    min-width: 35px;\\r\\n    text-align: right;\\r\\n    margin-right: 12px;\\r\\n    user-select: none;\\r\\n    font-size: 11px;\\r\\n    opacity: 0.6;\\r\\n    flex-shrink: 0;\\r\\n    display: inline-block;\\r\\n}\\r\\n\\r\\n.log-entry .time {\\r\\n    color: var(--info-color);\\r\\n    margin-right: 12px;\\r\\n    font-size: 12px;\\r\\n    opacity: 0.9;\\r\\n    font-weight: 500;\\r\\n    flex-shrink: 0;\\r\\n    display: inline-block;\\r\\n    white-space: nowrap;\\r\\n}\\r\\n\\r\\n.log-entry .level-tag {\\r\\n    display: inline-flex;\\r\\n    align-items: center;\\r\\n    min-width: 55px;\\r\\n    font-weight: bold;\\r\\n    font-size: 11px;\\r\\n    margin-right: 10px;\\r\\n    text-transform: uppercase;\\r\\n    gap: 4px;\\r\\n    flex-shrink: 0;\\r\\n    white-space: nowrap;\\r\\n}\\r\\n\\r\\n.log-entry .level-tag i {\\r\\n    font-size: 10px;\\r\\n}\\r\\n\\r\\n.log-entry .message {\\r\\n    flex: 1;\\r\\n    white-space: pre;\\r\\n}\\r\\n\\r\\n/* 日志模块标签 */\\r\\n.log-module-tag {\\r\\n    font-weight: 600;\\r\\n    font-size: 11px;\\r\\n    margin-right: 8px;\\r\\n    flex-shrink: 0;\\r\\n    white-space: nowrap;\\r\\n}\\r\\n\\r\\n/* 不同模块的颜色 */\\r\\n.module-servermonitor {\\r\\n    color: #10b981;\\r\\n}\\r\\n\\r\\n/* 绿色 */\\r\\n.module-server {\\r\\n    color: #10b981;\\r\\n}\\r\\n\\r\\n.module-http {\\r\\n    color: #3b82f6;\\r\\n}\\r\\n\\r\\n/* 蓝色 */\\r\\n.module-logservice {\\r\\n    color: #8b5cf6;\\r\\n}\\r\\n\\r\\n/* 紫色 */\\r\\n.module-database {\\r\\n    color: #f59e0b;\\r\\n}\\r\\n\\r\\n/* 橙色 */\\r\\n.module-db {\\r\\n    color: #f59e0b;\\r\\n}\\r\\n\\r\\n.module-auth {\\r\\n    color: #ef4444;\\r\\n}\\r\\n\\r\\n/* 红色 */\\r\\n.module-websocket {\\r\\n    color: #06b6d4;\\r\\n}\\r\\n\\r\\n/* 青色 */\\r\\n.module-ws {\\r\\n    color: #06b6d4;\\r\\n}\\r\\n\\r\\n.module-api {\\r\\n    color: #ec4899;\\r\\n}\\r\\n\\r\\n/* 粉色 */\\r\\n.module-core {\\r\\n    color: #6b7280;\\r\\n}\\r\\n\\r\\n/* 灰色 */\\r\\n.module-antigravity {\\r\\n    color: var(--ag-primary, #a855f7);\\r\\n}\\r\\n\\r\\n/* Antigravity 紫色 */\\r\\n.module-gemini {\\r\\n    color: var(--gemini-primary, #4285f4);\\r\\n}\\r\\n\\r\\n/* Gemini 蓝色 */\\r\\n.module-dns {\\r\\n    color: #f97316;\\r\\n}\\r\\n\\r\\n/* CF DNS 橙色 */\\r\\n.module-paas {\\r\\n    color: #14b8a6;\\r\\n}\\r\\n\\r\\n/* PaaS 青绿色 */\\r\\n.module-openai {\\r\\n    color: #22c55e;\\r\\n}\\r\\n\\r\\n/* OpenAI 绿色 */\\r\\n\\r\\n.log-footer {\\r\\n    height: 36px;\\r\\n    background-color: var(--primary-color);\\r\\n    color: #fff;\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    padding: 0 20px;\\r\\n    font-size: 11px;\\r\\n    gap: 16px;\\r\\n    flex-shrink: 0;\\r\\n    /* 移除内部投影，由外部 modal 容器统一处理圆角 */\\r\\n    box-shadow: none;\\r\\n    border-top: 1px solid rgba(255, 255, 255, 0.1);\\r\\n}\\r\\n\\r\\n.footer-stat {\\r\\n    display: flex;\\r\\n    align-items: center;\\r\\n    gap: 6px;\\r\\n    font-weight: 600;\\r\\n}\\r\\n\\r\\n@keyframes blink {\\r\\n\\r\\n    0%,\\r\\n    100% {\\r\\n        opacity: 1;\\r\\n    }\\r\\n\\r\\n    50% {\\r\\n        opacity: 0.4;\\r\\n    }\\r\\n}\\r\\n\\r\\n/* ANSI Colors - Adaptive */\\r\\n.ansi-fg-30 {\\r\\n    color: var(--text-tertiary);\\r\\n}\\r\\n\\r\\n.ansi-fg-31 {\\r\\n    color: var(--danger-color);\\r\\n}\\r\\n\\r\\n.ansi-fg-32 {\\r\\n    color: var(--success-color);\\r\\n}\\r\\n\\r\\n.ansi-fg-33 {\\r\\n    color: var(--warning-color);\\r\\n}\\r\\n\\r\\n.ansi-fg-34 {\\r\\n    color: var(--info-color);\\r\\n}\\r\\n\\r\\n.ansi-fg-35 {\\r\\n    color: #c678dd;\\r\\n}\\r\\n\\r\\n/* Purple */\\r\\n.ansi-fg-36 {\\r\\n    color: #56b6c2;\\r\\n}\\r\\n\\r\\n/* Cyan */\\r\\n.ansi-fg-37 {\\r\\n    color: var(--text-primary);\\r\\n}\\r\\n\\r\\n/* White */\\r\\n.ansi-fg-39 {\\r\\n    color: #cccccc;\\r\\n}\\r\\n\\r\\n/* Default */\\r\\n\\r\\n/* 适配移动端 */\\r\\n@media (max-width: 600px) {\\r\\n    .log-viewer-modal {\\r\\n        width: 100vw;\\r\\n        height: 100vh;\\r\\n        max-width: none;\\r\\n        max-height: none;\\r\\n        border-radius: 0;\\r\\n    }\\r\\n\\r\\n    .log-actions span {\\r\\n        display: none;\\r\\n    }\\r\\n\\r\\n    .log-title-group .log-icon {\\r\\n        display: none;\\r\\n    }\\r\\n}\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
