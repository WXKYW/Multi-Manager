          "content": {
            "size": 258999,
            "mimeType": "text/javascript",
            "compression": 0,
            "text": "export default \"<!-- ==================== Gemini CLI 管理部分 ==================== -->\\r\\n<div class=\\\"tab-content gemini-cli-content theme-gemini-cli\\\" :class=\\\"getTabAnimationClass('gemini-cli')\\\">\\r\\n\\r\\n  <!-- Gemini CLI 子标签页 -->\\r\\n  <div class=\\\"sec-tabs gemini-sec-tabs\\\">\\r\\n    <button class=\\\"tab-btn\\\" :class=\\\"{ active: geminiCliCurrentTab === 'models' || geminiCliCurrentTab === 'quotas' }\\\"\\r\\n      @click=\\\"switchGeminiCliTab('models')\\\">\\r\\n      <i class=\\\"fas fa-th-list\\\"></i> 模型矩阵\\r\\n    </button>\\r\\n    <button class=\\\"tab-btn\\\" :class=\\\"{ active: geminiCliCurrentTab === 'accounts' }\\\"\\r\\n      @click=\\\"switchGeminiCliTab('accounts')\\\">\\r\\n      <i class=\\\"fas fa-list\\\"></i> 账号管理\\r\\n    </button>\\r\\n    <button class=\\\"tab-btn\\\" :class=\\\"{ active: geminiCliCurrentTab === 'logs' }\\\" @click=\\\"switchGeminiCliTab('logs')\\\">\\r\\n      <i class=\\\"fas fa-history\\\"></i> 调用日志\\r\\n    </button>\\r\\n    <button class=\\\"tab-btn\\\" :class=\\\"{ active: geminiCliCurrentTab === 'settings' }\\\"\\r\\n      @click=\\\"switchGeminiCliTab('settings')\\\">\\r\\n      <i class=\\\"fas fa-cog\\\"></i> 模块配置\\r\\n    </button>\\r\\n  </div>\\r\\n\\r\\n  <!-- 模型列表标签页 -->\\r\\n  <div v-show=\\\"geminiCliCurrentTab === 'models' || geminiCliCurrentTab === 'quotas'\\\"\\r\\n    class=\\\"sub-tab-content quick-fade-in\\\">\\r\\n    <div class=\\\"panel-header\\\" style=\\\"justify-content: space-between; padding-bottom: 10px;\\\">\\r\\n      <div style=\\\"display: flex; gap: 16px; align-items: center;\\\">\\r\\n        <div class=\\\"panel-title\\\"><i class=\\\"fas fa-th-large\\\"\\r\\n            style=\\\"margin-right: 8px; color: var(--gemini-primary);\\\"></i>Model Matrix</div>\\r\\n      </div>\\r\\n      <div style=\\\"display: flex; gap: 8px;\\\">\\r\\n        <button class=\\\"btn btn-primary btn-sm\\\" @click=\\\"saveGeminiCliMatrix\\\" :disabled=\\\"geminiCliModelLoading\\\">\\r\\n          <i class=\\\"fas fa-save\\\"></i> 保存配置\\r\\n        </button>\\r\\n        <button class=\\\"btn btn-secondary btn-sm\\\" @click=\\\"loadGeminiCliMatrix\\\" :disabled=\\\"geminiCliModelLoading\\\">\\r\\n          <i class=\\\"fas fa-sync-alt\\\" :class=\\\"{ 'fa-spin': geminiCliModelLoading }\\\"></i> 刷新配置\\r\\n        </button>\\r\\n      </div>\\r\\n    </div>\\r\\n\\r\\n    <div v-if=\\\"geminiCliModelLoading && !geminiCliMatrix\\\" class=\\\"loading\\\">\\r\\n      <div class=\\\"spinner\\\"></div>\\r\\n      <div style=\\\"margin-top: 12px;\\\">正在获取配置...</div>\\r\\n    </div>\\r\\n\\r\\n    <div v-else class=\\\"ag-quota-list-view\\\">\\r\\n      <div class=\\\"panel\\\">\\r\\n        <div class=\\\"table-container\\\">\\r\\n          <table class=\\\"data-table model-matrix-table\\\">\\r\\n            <thead>\\r\\n              <tr>\\r\\n                <th style=\\\"width: 200px;\\\">模型名称</th>\\r\\n                <th class=\\\"text-center\\\">\\r\\n                  <div class=\\\"matrix-header-cell\\\" @click=\\\"toggleMatrixColumn('base')\\\">\\r\\n                    <span>基础模型</span>\\r\\n                    <label class=\\\"switch\\\">\\r\\n                      <input type=\\\"checkbox\\\" :checked=\\\"isMatrixColumnAllChecked('base')\\\" readonly>\\r\\n                      <span class=\\\"slider round\\\"></span>\\r\\n                    </label>\\r\\n                  </div>\\r\\n                </th>\\r\\n                <th class=\\\"text-center\\\">\\r\\n                  <div class=\\\"matrix-header-cell\\\" @click=\\\"toggleMatrixColumn('maxThinking')\\\">\\r\\n                    <span>深度思考</span>\\r\\n                    <label class=\\\"switch\\\">\\r\\n                      <input type=\\\"checkbox\\\" :checked=\\\"isMatrixColumnAllChecked('maxThinking')\\\" readonly>\\r\\n                      <span class=\\\"slider round\\\"></span>\\r\\n                    </label>\\r\\n                  </div>\\r\\n                </th>\\r\\n                <th class=\\\"text-center\\\">\\r\\n                  <div class=\\\"matrix-header-cell\\\" @click=\\\"toggleMatrixColumn('noThinking')\\\">\\r\\n                    <span>快速思考</span>\\r\\n                    <label class=\\\"switch\\\">\\r\\n                      <input type=\\\"checkbox\\\" :checked=\\\"isMatrixColumnAllChecked('noThinking')\\\" readonly>\\r\\n                      <span class=\\\"slider round\\\"></span>\\r\\n                    </label>\\r\\n                  </div>\\r\\n                </th>\\r\\n                <th class=\\\"text-center\\\">\\r\\n                  <div class=\\\"matrix-header-cell\\\" @click=\\\"toggleMatrixColumn('search')\\\">\\r\\n                    <span>联网搜索</span>\\r\\n                    <label class=\\\"switch\\\">\\r\\n                      <input type=\\\"checkbox\\\" :checked=\\\"isMatrixColumnAllChecked('search')\\\" readonly>\\r\\n                      <span class=\\\"slider round\\\"></span>\\r\\n                    </label>\\r\\n                  </div>\\r\\n                </th>\\r\\n                <th class=\\\"text-center\\\">\\r\\n                  <div class=\\\"matrix-header-cell\\\" @click=\\\"toggleMatrixColumn('fakeStream')\\\">\\r\\n                    <span>假流</span>\\r\\n                    <label class=\\\"switch\\\">\\r\\n                      <input type=\\\"checkbox\\\" :checked=\\\"isMatrixColumnAllChecked('fakeStream')\\\" readonly>\\r\\n                      <span class=\\\"slider round\\\"></span>\\r\\n                    </label>\\r\\n                  </div>\\r\\n                </th>\\r\\n                <th class=\\\"text-center\\\">\\r\\n                  <div class=\\\"matrix-header-cell\\\" @click=\\\"toggleMatrixColumn('antiTrunc')\\\">\\r\\n                    <span>流抗</span>\\r\\n                    <label class=\\\"switch\\\">\\r\\n                      <input type=\\\"checkbox\\\" :checked=\\\"isMatrixColumnAllChecked('antiTrunc')\\\" readonly>\\r\\n                      <span class=\\\"slider round\\\"></span>\\r\\n                    </label>\\r\\n                  </div>\\r\\n                </th>\\r\\n              </tr>\\r\\n            </thead>\\r\\n            <tbody>\\r\\n              <tr v-for=\\\"row in getGeminiCliMatrixList()\\\" :key=\\\"row.id\\\">\\r\\n                <td style=\\\"font-family: var(--font-mono); font-weight: 600; cursor: pointer; user-select: none;\\\"\\r\\n                  @click=\\\"toggleGeminiCliMatrixRow(row.id)\\\" title=\\\"点击切换整行开关\\\">\\r\\n                  {{ row.id }}\\r\\n                </td>\\r\\n                <td class=\\\"text-center\\\">\\r\\n                  <label class=\\\"switch\\\">\\r\\n                    <input type=\\\"checkbox\\\" :checked=\\\"row.base\\\" @change=\\\"toggleMatrixItem(row.id, 'base')\\\">\\r\\n                    <span class=\\\"slider round\\\"></span>\\r\\n                  </label>\\r\\n                </td>\\r\\n                <td class=\\\"text-center\\\">\\r\\n                  <label class=\\\"switch\\\">\\r\\n                    <input type=\\\"checkbox\\\" :checked=\\\"row.maxThinking\\\" @change=\\\"toggleMatrixItem(row.id, 'maxThinking')\\\">\\r\\n                    <span class=\\\"slider round\\\"></span>\\r\\n                  </label>\\r\\n                </td>\\r\\n                <td class=\\\"text-center\\\">\\r\\n                  <label class=\\\"switch\\\">\\r\\n                    <input type=\\\"checkbox\\\" :checked=\\\"row.noThinking\\\" @change=\\\"toggleMatrixItem(row.id, 'noThinking')\\\">\\r\\n                    <span class=\\\"slider round\\\"></span>\\r\\n                  </label>\\r\\n                </td>\\r\\n                <td class=\\\"text-center\\\">\\r\\n                  <label class=\\\"switch\\\">\\r\\n                    <input type=\\\"checkbox\\\" :checked=\\\"row.search\\\" @change=\\\"toggleMatrixItem(row.id, 'search')\\\">\\r\\n                    <span class=\\\"slider round\\\"></span>\\r\\n                  </label>\\r\\n                </td>\\r\\n                <td class=\\\"text-center\\\">\\r\\n                  <label class=\\\"switch\\\">\\r\\n                    <input type=\\\"checkbox\\\" :checked=\\\"row.fakeStream\\\" @change=\\\"toggleMatrixItem(row.id, 'fakeStream')\\\">\\r\\n                    <span class=\\\"slider round\\\"></span>\\r\\n                  </label>\\r\\n                </td>\\r\\n                <td class=\\\"text-center\\\">\\r\\n                  <label class=\\\"switch\\\">\\r\\n                    <input type=\\\"checkbox\\\" :checked=\\\"row.antiTrunc\\\" @change=\\\"toggleMatrixItem(row.id, 'antiTrunc')\\\">\\r\\n                    <span class=\\\"slider round\\\"></span>\\r\\n                  </label>\\r\\n                </td>\\r\\n              </tr>\\r\\n              <tr v-if=\\\"getGeminiCliMatrixList().length === 0\\\">\\r\\n                <td colspan=\\\"7\\\" style=\\\"text-align: center; padding: 40px; opacity: 0.5;\\\">\\r\\n                  <i class=\\\"fas fa-info-circle\\\"></i> 暂无配置数据\\r\\n                </td>\\r\\n              </tr>\\r\\n\\r\\n            </tbody>\\r\\n          </table>\\r\\n        </div>\\r\\n      </div>\\r\\n    </div>\\r\\n  </div>\\r\\n\\r\\n  <!-- 账号管理标签页 -->\\r\\n  <div v-if=\\\"geminiCliCurrentTab === 'accounts'\\\" class=\\\"sub-tab-content quick-fade-in\\\">\\r\\n    <div class=\\\"panel\\\">\\r\\n      <div class=\\\"panel-header\\\" style=\\\"padding-bottom: 6px;\\\">\\r\\n        <div style=\\\"display: flex; gap: 8px;\\\">\\r\\n          <button class=\\\"btn btn-gemini\\\" @click=\\\"showGeminiCliOAuthExpand = !showGeminiCliOAuthExpand\\\">\\r\\n            <i class=\\\"fab fa-google\\\"></i> OAuth 授权\\r\\n          </button>\\r\\n          <button class=\\\"btn btn-success\\\" @click=\\\"openAddGeminiCliAccountModal\\\">\\r\\n            <i class=\\\"fas fa-plus-circle\\\"></i> 手动添加\\r\\n          </button>\\r\\n          <button class=\\\"btn btn-secondary\\\" @click=\\\"refreshGeminiCliAccounts\\\" :disabled=\\\"geminiCliLoading\\\"\\r\\n            title=\\\"刷新全部账号\\\" style=\\\"padding: 0 12px;\\\">\\r\\n            <i class=\\\"fas fa-sync-alt\\\" :class=\\\"{ 'fa-spin': geminiCliLoading }\\\"></i>\\r\\n          </button>\\r\\n          <button class=\\\"btn btn-secondary\\\" @click=\\\"exportGeminiCliAccounts\\\" title=\\\"导出账号\\\" style=\\\"padding: 0 12px;\\\">\\r\\n            <i class=\\\"fas fa-upload\\\"></i>\\r\\n          </button>\\r\\n          <button class=\\\"btn btn-secondary\\\" @click=\\\"importGeminiCliAccountsFromFile\\\" title=\\\"导入账号\\\"\\r\\n            style=\\\"padding: 0 12px;\\\">\\r\\n            <i class=\\\"fas fa-download\\\"></i>\\r\\n          </button>\\r\\n        </div>\\r\\n      </div>\\r\\n\\r\\n      <!-- Expandable OAuth Panel -->\\r\\n      <div class=\\\"ag-expandable-panel gemini-oauth-panel\\\" :class=\\\"{ expanded: showGeminiCliOAuthExpand }\\\">\\r\\n        <div class=\\\"panel-header\\\" style=\\\"border-bottom: none; padding-bottom: 0;\\\">\\r\\n          <div class=\\\"panel-title\\\" style=\\\"width: 100%; text-align: center; padding-top: 10px;\\\"><i class=\\\"fab fa-google\\\"\\r\\n              style=\\\"margin-right: 8px; color: var(--gemini-primary);\\\"></i>连接 Google 账号</div>\\r\\n        </div>\\r\\n\\r\\n        <div class=\\\"oauth-modern-body\\\">\\r\\n          <!-- Step 1 -->\\r\\n          <div class=\\\"oauth-step-item\\\">\\r\\n            <div class=\\\"step-badge\\\">1</div>\\r\\n            <div class=\\\"step-content\\\">\\r\\n              <div class=\\\"step-text\\\">登录 Google 以获取授权码</div>\\r\\n              <button class=\\\"btn btn-gemini btn-block\\\" @click=\\\"openGeminiCliAuthUrl\\\">\\r\\n                <i class=\\\"fab fa-google\\\"></i> 获取授权链接\\r\\n              </button>\\r\\n              <div\\r\\n                style=\\\"margin-top: 8px; font-size: 11px; color: var(--text-tertiary); display: flex; align-items: flex-start; gap: 6px;\\\">\\r\\n                <i class=\\\"fas fa-info-circle\\\" style=\\\"margin-top: 2px; opacity: 0.7;\\\"></i>\\r\\n                <span>登录时显示 \\\"Google Antigravity\\\" 为正常现象，因该模块共用内部 OAuth 应用。两者访问的 API 端点不同，模型列表也有差异。</span>\\r\\n              </div>\\r\\n            </div>\\r\\n          </div>\\r\\n\\r\\n          <!-- Divider -->\\r\\n          <div class=\\\"oauth-step-line\\\"></div>\\r\\n\\r\\n          <!-- Step 2 -->\\r\\n          <div class=\\\"oauth-step-item\\\">\\r\\n            <div class=\\\"step-badge\\\">2</div>\\r\\n            <div class=\\\"step-content\\\">\\r\\n              <div class=\\\"step-text\\\">在下方粘贴重定向后的 URL</div>\\r\\n              <textarea v-model=\\\"geminiCliOauthReturnUrl\\\" class=\\\"form-textarea oauth-textarea\\\"\\r\\n                placeholder=\\\"粘贴以 http:// 开头的完整 URL...\\\" spellcheck=\\\"false\\\"></textarea>\\r\\n            </div>\\r\\n          </div>\\r\\n\\r\\n          <!-- Options -->\\r\\n          <div class=\\\"oauth-options\\\">\\r\\n            <div class=\\\"oauth-option-row\\\">\\r\\n              <input type=\\\"text\\\" v-model=\\\"geminiCliCustomProjectId\\\" class=\\\"form-input input-sm\\\"\\r\\n                placeholder=\\\"自定义项目 ID (可选)\\\">\\r\\n              <div style=\\\"display: flex; align-items: center; gap: 8px;\\\">\\r\\n                <label class=\\\"switch\\\">\\r\\n                  <input type=\\\"checkbox\\\" v-model=\\\"geminiCliAllowRandomProjectId\\\">\\r\\n                  <span class=\\\"slider round\\\"></span>\\r\\n                </label>\\r\\n                <span style=\\\"font-size: 12px; color: var(--text-secondary);\\\">允许随机 ID</span>\\r\\n              </div>\\r\\n            </div>\\r\\n          </div>\\r\\n\\r\\n          <!-- Action -->\\r\\n          <button class=\\\"btn btn-success btn-block btn-lg mt-3\\\" @click=\\\"parseGeminiCliOauthUrl\\\"\\r\\n            :disabled=\\\"!geminiCliOauthReturnUrl || geminiCliLoading\\\">\\r\\n            <i class=\\\"fas\\\" :class=\\\"geminiCliLoading ? 'fa-spinner fa-spin' : 'fa-link'\\\"></i>\\r\\n            {{ geminiCliLoading ? '验证中...' : '验证并连接' }}\\r\\n          </button>\\r\\n        </div>\\r\\n      </div>\\r\\n\\r\\n      <!-- 统计信息栏 -->\\r\\n      <div v-if=\\\"geminiCliStats\\\" class=\\\"stats-bar\\\"\\r\\n        style=\\\"display: none; gap: 20px; padding: 12px 16px; margin-bottom: 2px; border-radius: 8px; font-size: 13px;\\\">\\r\\n        <div class=\\\"stat-item\\\">\\r\\n          <span style=\\\"opacity: 0.7;\\\">总账号:</span>\\r\\n          <strong style=\\\"margin-left: 4px;\\\">{{ geminiCliStats.total_accounts || 0 }}</strong>\\r\\n        </div>\\r\\n        <div class=\\\"stat-item\\\">\\r\\n          <span style=\\\"opacity: 0.7;\\\">活跃:</span>\\r\\n          <strong style=\\\"margin-left: 4px; color: var(--success-color);\\\">{{ geminiCliStats.active_accounts || 0\\r\\n            }}</strong>\\r\\n        </div>\\r\\n      </div>\\r\\n\\r\\n      <div v-if=\\\"geminiCliLoading && geminiCliAccounts.length === 0\\\" class=\\\"loading\\\">\\r\\n        <div class=\\\"spinner\\\"></div>\\r\\n        <div style=\\\"margin-top: 12px;\\\">加载中...</div>\\r\\n      </div>\\r\\n\\r\\n      <!-- 账号表格 -->\\r\\n      <div v-else class=\\\"table-container\\\">\\r\\n        <table class=\\\"data-table\\\">\\r\\n          <thead>\\r\\n            <tr>\\r\\n              <th style=\\\"width: 40px;\\\">#</th>\\r\\n              <th>备注名称</th>\\r\\n              <th>项目 ID</th>\\r\\n              <th>邮箱</th>\\r\\n              <th class=\\\"text-center\\\">状态</th>\\r\\n              <th class=\\\"text-center\\\">冻结状态</th>\\r\\n              <th class=\\\"text-center\\\">操作</th>\\r\\n            </tr>\\r\\n          </thead>\\r\\n          <tbody>\\r\\n            <tr v-for=\\\"(account, index) in geminiCliAccounts\\\" :key=\\\"account.id\\\">\\r\\n              <td data-label=\\\"#\\\" style=\\\"font-weight: 600; opacity: 0.6;\\\">{{ index + 1 }}</td>\\r\\n              <td data-label=\\\"备注名称\\\"><strong>{{ account.name || '未命名' }}</strong></td>\\r\\n              <td data-label=\\\"项目 ID\\\"><code class=\\\"code-sm\\\">{{ account.project_id || '-' }}</code></td>\\r\\n              <td data-label=\\\"邮箱\\\"><span style=\\\"font-size: 11px; opacity: 0.7;\\\">{{ account.email || '-' }}</span></td>\\r\\n              <td data-label=\\\"当前状态\\\" class=\\\"text-center\\\">\\r\\n                <div class=\\\"flex-cell\\\">\\r\\n                  <span class=\\\"ag-status-badge\\\"\\r\\n                    :class=\\\"account.status === 'online' ? 'ag-status-online' : (account.status === 'error' ? 'ag-status-error' : 'ag-status-unknown')\\\">\\r\\n                    {{ account.status === 'online' ? '在线' : (account.status === 'error' ? '异常' : '未知') }}\\r\\n                  </span>\\r\\n                </div>\\r\\n              </td>\\r\\n              <td data-label=\\\"冻结状态\\\" class=\\\"text-center\\\">\\r\\n                <div class=\\\"flex-cell\\\">\\r\\n                  <span v-if=\\\"!account.coolDowns || account.coolDowns.length === 0\\\"\\r\\n                    class=\\\"ag-status-badge ag-status-online\\\">\\r\\n                    正常\\r\\n                  </span>\\r\\n                  <span v-else class=\\\"ag-status-badge ag-status-warning\\\" style=\\\"cursor: pointer;\\\"\\r\\n                    :title=\\\"formatCoolDownTitle(account.coolDowns)\\\">\\r\\n                    <i class=\\\"fas fa-snowflake\\\" style=\\\"margin-right: 4px;\\\"></i>\\r\\n                    {{ account.coolDowns.length }} 模型受限\\r\\n                  </span>\\r\\n                </div>\\r\\n              </td>\\r\\n              <td class=\\\"actions text-center\\\">\\r\\n                <div class=\\\"flex-cell\\\">\\r\\n                  <button class=\\\"btn btn-icon-refined\\\"\\r\\n                    :style=\\\"{ color: account.enable ? 'var(--success-color)' : 'var(--text-tertiary)' }\\\"\\r\\n                    @click=\\\"toggleGeminiCliAccount(account)\\\" :title=\\\"account.enable ? '禁用账号' : '启用账号'\\\">\\r\\n                    <i class=\\\"fas\\\" :class=\\\"account.enable ? 'fa-toggle-on' : 'fa-toggle-off'\\\"></i>\\r\\n                  </button>\\r\\n                  <button class=\\\"btn btn-icon-refined\\\" @click=\\\"editGeminiCliAccount(account)\\\" title=\\\"编辑配置\\\">\\r\\n                    <i class=\\\"fas fa-edit\\\"></i>\\r\\n                  </button>\\r\\n                  <button class=\\\"btn btn-icon-refined\\\" @click=\\\"deleteGeminiCliAccount(account)\\\" title=\\\"删除授权\\\"\\r\\n                    style=\\\"color: var(--danger-color);\\\">\\r\\n                    <i class=\\\"fas fa-trash\\\"></i>\\r\\n                  </button>\\r\\n                </div>\\r\\n              </td>\\r\\n            </tr>\\r\\n\\r\\n          </tbody>\\r\\n        </table>\\r\\n        <div v-if=\\\"geminiCliAccounts.length === 0\\\" class=\\\"empty-state\\\">\\r\\n          <i class=\\\"fas fa-terminal\\\" style=\\\"font-size: 48px; margin-bottom: 16px;\\\"></i>\\r\\n          <div>暂无账号，点击上方按钮新增授权</div>\\r\\n        </div>\\r\\n      </div>\\r\\n    </div>\\r\\n\\r\\n    <!-- 模型健康检测历史 -->\\r\\n    <div class=\\\"panel\\\" style=\\\"margin-top: 16px;\\\">\\r\\n      <div class=\\\"panel-header\\\" style=\\\"padding-bottom: 6px;\\\">\\r\\n        <div class=\\\"panel-title\\\">\\r\\n          <i class=\\\"fas fa-heartbeat\\\" style=\\\"margin-right: 8px; color: var(--gemini-primary);\\\"></i>模型健康检测\\r\\n        </div>\\r\\n        <div style=\\\"display: flex; gap: 8px; align-items: center;\\\">\\r\\n          <!-- 定时检测开关 -->\\r\\n          <div style=\\\"display: flex; align-items: center; gap: 6px; font-size: 12px; margin-right: 8px;\\\">\\r\\n            <label class=\\\"switch\\\" style=\\\"transform: scale(0.8);\\\">\\r\\n              <input type=\\\"checkbox\\\" v-model=\\\"geminiCliAutoCheck\\\" @change=\\\"toggleGeminiCliAutoCheck\\\">\\r\\n              <span class=\\\"slider round\\\"></span>\\r\\n            </label>\\r\\n            <span style=\\\"opacity: 0.8;\\\">定时</span>\\r\\n            <select v-model=\\\"geminiCliAutoCheckInterval\\\" @change=\\\"restartGeminiCliAutoCheck\\\"\\r\\n              class=\\\"auto-check-select\\\">\\r\\n              <option value=\\\"1800000\\\">30分钟</option>\\r\\n              <option value=\\\"3600000\\\">1小时</option>\\r\\n              <option value=\\\"7200000\\\">2小时</option>\\r\\n              <option value=\\\"14400000\\\">4小时</option>\\r\\n              <option value=\\\"21600000\\\">6小时</option>\\r\\n            </select>\\r\\n          </div>\\r\\n          <button class=\\\"btn btn-primary btn-sm\\\" @click=\\\"runGeminiCliModelCheck\\\" :disabled=\\\"geminiCliChecking\\\">\\r\\n            <i class=\\\"fas\\\" :class=\\\"geminiCliChecking ? 'fa-spinner fa-spin' : 'fa-play'\\\"></i>\\r\\n            {{ geminiCliChecking ? '检测中...' : '执行检测' }}\\r\\n          </button>\\r\\n          <button class=\\\"btn btn-secondary btn-sm\\\" @click=\\\"loadGeminiCliCheckHistory\\\">\\r\\n            <i class=\\\"fas fa-sync-alt\\\"></i>\\r\\n          </button>\\r\\n          <button class=\\\"btn btn-secondary btn-sm\\\" @click=\\\"clearGeminiCliCheckHistory\\\"\\r\\n            style=\\\"color: var(--danger-color);\\\" title=\\\"清空历史\\\">\\r\\n            <i class=\\\"fas fa-trash\\\"></i>\\r\\n          </button>\\r\\n        </div>\\r\\n      </div>\\r\\n\\r\\n      <!-- 检测历史矩阵 -->\\r\\n      <div v-if=\\\"geminiCliCheckHistory && geminiCliCheckHistory.models.length > 0\\\" class=\\\"table-container\\\">\\r\\n        <table class=\\\"data-table\\\" style=\\\"font-size: 12px;\\\">\\r\\n          <thead>\\r\\n            <tr>\\r\\n              <th style=\\\"width: 180px;\\\">模型</th>\\r\\n              <th v-for=\\\"time in geminiCliCheckHistory.times.slice().reverse()\\\" :key=\\\"time\\\" class=\\\"text-center\\\"\\r\\n                style=\\\"min-width: 80px; font-size: 11px;\\\">\\r\\n                {{ formatGeminiCliCheckTime(time) }}\\r\\n              </th>\\r\\n            </tr>\\r\\n          </thead>\\r\\n          <tbody>\\r\\n            <tr v-for=\\\"model in geminiCliCheckHistory.models\\\" :key=\\\"model\\\">\\r\\n              <td style=\\\"font-family: monospace; font-size: 11px;\\\">\\r\\n                <div style=\\\"display: flex; align-items: center; gap: 6px;\\\">\\r\\n                  <label class=\\\"switch\\\" style=\\\"transform: scale(0.6); margin: 0;\\\">\\r\\n                    <input type=\\\"checkbox\\\" :checked=\\\"!geminiCliDisabledCheckModels.includes(model)\\\"\\r\\n                      @change=\\\"toggleGeminiCliCheckModel(model)\\\">\\r\\n                    <span class=\\\"slider round\\\"></span>\\r\\n                  </label>\\r\\n                  <span :style=\\\"{ opacity: geminiCliDisabledCheckModels.includes(model) ? 0.4 : 1 }\\\">{{ model }}</span>\\r\\n                </div>\\r\\n              </td>\\r\\n              <td v-for=\\\"time in geminiCliCheckHistory.times.slice().reverse()\\\" :key=\\\"time\\\" class=\\\"text-center\\\">\\r\\n                <template v-if=\\\"geminiCliCheckHistory.matrix[model] && geminiCliCheckHistory.matrix[model][time]\\\">\\r\\n                  <span v-for=\\\"n in geminiCliAccounts.length\\\" :key=\\\"n\\\" class=\\\"check-badge\\\"\\r\\n                    :class=\\\"getGeminiCliCheckBadgeClass(geminiCliCheckHistory.matrix[model][time], n)\\\"\\r\\n                    :title=\\\"getGeminiCliCheckBadgeTitle(geminiCliCheckHistory.matrix[model][time], n)\\\">\\r\\n                    {{ n }}\\r\\n                  </span>\\r\\n                </template>\\r\\n                <span v-else class=\\\"check-badge check-badge-unknown\\\" title=\\\"未检测\\\">-</span>\\r\\n              </td>\\r\\n            </tr>\\r\\n          </tbody>\\r\\n        </table>\\r\\n      </div>\\r\\n      <!-- 检测中占位符 -->\\r\\n      <div v-else-if=\\\"geminiCliChecking\\\" style=\\\"text-align: center; padding: 40px;\\\">\\r\\n        <div class=\\\"spinner\\\" style=\\\"margin: 0 auto 16px;\\\"></div>\\r\\n        <div style=\\\"font-size: 13px; opacity: 0.7;\\\">正在检测模型健康状态...</div>\\r\\n      </div>\\r\\n      <div v-else style=\\\"text-align: center; padding: 30px; opacity: 0.5; font-size: 13px;\\\">\\r\\n        <i class=\\\"fas fa-info-circle\\\" style=\\\"margin-right: 6px;\\\"></i>\\r\\n        暂无检测记录。点击「执行检测」开始首次检测。\\r\\n      </div>\\r\\n    </div>\\r\\n  </div>\\r\\n\\r\\n  <!-- 调用日志标签页 -->\\r\\n  <div v-show=\\\"geminiCliCurrentTab === 'logs'\\\" class=\\\"sub-tab-content quick-fade-in\\\">\\r\\n    <div class=\\\"panel\\\">\\r\\n      <div class=\\\"panel-header log-header-adaptive\\\">\\r\\n        <div class=\\\"panel-title-group\\\">\\r\\n          <div class=\\\"panel-title\\\"><i class=\\\"fas fa-history\\\"\\r\\n              style=\\\"margin-right: 8px; color: var(--gemini-primary);\\\"></i>日志管理</div>\\r\\n        </div>\\r\\n        <div class=\\\"panel-actions-group\\\">\\r\\n          <select v-model=\\\"geminiCliLogFilterAccount\\\" class=\\\"form-input select-sm-adaptive\\\">\\r\\n            <option value=\\\"\\\">全部账号</option>\\r\\n            <option v-for=\\\"acc in geminiCliAccounts.filter(a => a.enable !== false && a.enable !== 0)\\\" :key=\\\"acc.id\\\"\\r\\n              :value=\\\"acc.id\\\">\\r\\n              {{ acc.name || acc.id }}\\r\\n            </option>\\r\\n          </select>\\r\\n          <select v-model=\\\"geminiCliLogFilterModel\\\" class=\\\"form-input select-sm-adaptive\\\">\\r\\n            <option value=\\\"\\\">全部模型</option>\\r\\n            <option v-for=\\\"model in getGeminiCliLogModels()\\\" :key=\\\"model\\\" :value=\\\"model\\\">{{ model }}</option>\\r\\n          </select>\\r\\n          <div style=\\\"display: flex; gap: 8px;\\\">\\r\\n            <button class=\\\"btn btn-secondary btn-sm\\\" @click=\\\"loadGeminiCliLogs\\\" :disabled=\\\"geminiCliLoading\\\" title=\\\"刷新\\\">\\r\\n              <i class=\\\"fas fa-sync-alt\\\" :class=\\\"{ 'fa-spin': geminiCliLoading }\\\"></i>\\r\\n            </button>\\r\\n            <button class=\\\"btn btn-danger btn-sm\\\" @click=\\\"clearGeminiCliLogs\\\" title=\\\"清空\\\">\\r\\n              <i class=\\\"fas fa-trash-alt\\\"></i>\\r\\n            </button>\\r\\n          </div>\\r\\n        </div>\\r\\n      </div>\\r\\n      <div class=\\\"table-container\\\">\\r\\n        <table class=\\\"data-table\\\">\\r\\n          <thead>\\r\\n            <tr>\\r\\n              <th style=\\\"width: 160px;\\\" class=\\\"text-center\\\">调用时间</th>\\r\\n              <th>账号备注</th>\\r\\n              <th style=\\\"width: 120px;\\\" class=\\\"text-center\\\">调用模型</th>\\r\\n              <th>接口路径</th>\\r\\n              <th class=\\\"text-center\\\" style=\\\"width: 80px;\\\">状态</th>\\r\\n              <th class=\\\"text-center\\\" style=\\\"width: 80px;\\\">耗时</th>\\r\\n              <th class=\\\"text-center\\\" style=\\\"width: 80px;\\\">操作</th>\\r\\n            </tr>\\r\\n          </thead>\\r\\n          <tbody>\\r\\n            <tr v-for=\\\"log in getFilteredGeminiCliLogs()\\\" :key=\\\"log.id\\\">\\r\\n              <td data-label=\\\"调用时间\\\" class=\\\"text-center\\\">\\r\\n                <div class=\\\"flex-cell\\\">\\r\\n                  <div class=\\\"log-time\\\">\\r\\n                    <i class=\\\"far fa-clock\\\" style=\\\"margin-right: 4px; opacity: 0.5;\\\"></i>\\r\\n                    {{ formatDateTime(log.timestamp) }}\\r\\n                  </div>\\r\\n                </div>\\r\\n              </td>\\r\\n              <td data-label=\\\"账号备注\\\">\\r\\n                <div style=\\\"display: flex; align-items: center; gap: 8px;\\\">\\r\\n                  <i class=\\\"fas fa-id-card\\\" style=\\\"font-size: 12px; color: var(--primary-color); opacity: 0.7;\\\"></i>\\r\\n                  <strong>{{ log.accountName || log.accountId }}</strong>\\r\\n                  <span v-if=\\\"log.isBalanced\\\" class=\\\"badge-lb\\\" title=\\\"经过全局负载均衡分发\\\">LB</span>\\r\\n                </div>\\r\\n              </td>\\r\\n              <td data-label=\\\"调用模型\\\" class=\\\"text-center\\\">\\r\\n                <div class=\\\"flex-cell\\\">\\r\\n                  <code class=\\\"code-sm\\\">{{ log.model || '-' }}</code>\\r\\n                </div>\\r\\n              </td>\\r\\n              <td data-label=\\\"接口路径\\\">\\r\\n                <div style=\\\"display: flex; align-items: center;\\\">\\r\\n                  <span class=\\\"method-badge\\\" :class=\\\"'method-' + (log.method || 'POST').toLowerCase()\\\">\\r\\n                    {{ log.method || 'POST' }}\\r\\n                  </span>\\r\\n                  <span class=\\\"log-path\\\" :title=\\\"log.path\\\">{{ log.path }}</span>\\r\\n                </div>\\r\\n              </td>\\r\\n              <td data-label=\\\"状态码\\\" class=\\\"text-center\\\">\\r\\n                <div class=\\\"flex-cell\\\">\\r\\n                  <span :class=\\\"getGcliStatusClass(log.statusCode)\\\" class=\\\"ag-status-badge\\\">\\r\\n                    {{ log.statusCode }}\\r\\n                  </span>\\r\\n                </div>\\r\\n              </td>\\r\\n              <td data-label=\\\"请求耗时\\\" class=\\\"text-center\\\">\\r\\n                <div class=\\\"flex-cell\\\">\\r\\n                  <span class=\\\"log-duration\\\">{{ log.durationMs }}ms</span>\\r\\n                </div>\\r\\n              </td>\\r\\n              <td class=\\\"actions text-center\\\">\\r\\n                <div class=\\\"flex-cell\\\">\\r\\n                  <button class=\\\"btn btn-icon-refined\\\" @click=\\\"viewGeminiCliLogDetail(log)\\\" title=\\\"查看详情\\\">\\r\\n                    <i class=\\\"fas fa-eye\\\"></i>\\r\\n                  </button>\\r\\n                </div>\\r\\n              </td>\\r\\n            </tr>\\r\\n            <tr v-if=\\\"getFilteredGeminiCliLogs().length === 0\\\">\\r\\n              <td colspan=\\\"7\\\" style=\\\"padding: 60px;\\\">\\r\\n                <div\\r\\n                  style=\\\"display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-tertiary);\\\">\\r\\n                  <i class=\\\"fas fa-inbox\\\" style=\\\"font-size: 40px; margin-bottom: 12px; opacity: 0.3;\\\"></i>\\r\\n                  <span>尚无调用记录</span>\\r\\n                </div>\\r\\n              </td>\\r\\n            </tr>\\r\\n          </tbody>\\r\\n        </table>\\r\\n      </div>\\r\\n    </div>\\r\\n  </div>\\r\\n\\r\\n  <!-- 模块设置标签页 -->\\r\\n  <div v-show=\\\"geminiCliCurrentTab === 'settings'\\\" class=\\\"sub-tab-content quick-fade-in\\\">\\r\\n    <div class=\\\"panel\\\">\\r\\n      <div class=\\\"panel-header\\\">\\r\\n        <div style=\\\"display: flex; justify-content: space-between; align-items: center; width: 100%;\\\">\\r\\n          <div class=\\\"panel-title-group\\\">\\r\\n            <div class=\\\"panel-title\\\"><i class=\\\"fas fa-cogs\\\"\\r\\n                style=\\\"margin-right: 8px; color: var(--gemini-primary);\\\"></i>GCL 配置</div>\\r\\n          </div>\\r\\n          <div style=\\\"display: flex; gap: 8px;\\\">\\r\\n            <button class=\\\"btn btn-secondary btn-sm\\\" @click=\\\"loadGeminiCliSettings\\\" :disabled=\\\"geminiCliLoading\\\">\\r\\n              <i class=\\\"fas fa-sync-alt\\\" :class=\\\"{ 'fa-spin': geminiCliLoading }\\\"></i> 刷新\\r\\n            </button>\\r\\n            <button class=\\\"btn btn-primary btn-sm\\\" @click=\\\"saveGeminiCliSettings\\\" :disabled=\\\"geminiCliSaving\\\">\\r\\n              <i class=\\\"fas\\\" :class=\\\"geminiCliSaving ? 'fa-spinner fa-spin' : 'fa-save'\\\"></i> 保存全局\\r\\n            </button>\\r\\n          </div>\\r\\n        </div>\\r\\n      </div>\\r\\n\\r\\n      <div style=\\\"padding: 10px 3px 3px 3px;\\\">\\r\\n        <!-- 生成参数 -->\\r\\n        <div style=\\\"margin-bottom: 24px;\\\">\\r\\n          <div style=\\\"font-size: 13px; font-weight: 600; margin-bottom: 10px; color: var(--gemini-primary);\\\">\\r\\n            <i class=\\\"fas fa-sliders-h\\\"></i> 生成参数\\r\\n          </div>\\r\\n          <div style=\\\"display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px;\\\">\\r\\n            <div>\\r\\n              <label style=\\\"font-size: 11px; opacity: 0.7; display: block; margin-bottom: 7px;\\\">默认温度</label>\\r\\n              <input type=\\\"number\\\" step=\\\"0.1\\\" min=\\\"0\\\" max=\\\"2\\\" v-model=\\\"geminiCliSettingsForm.DEFAULT_TEMPERATURE\\\"\\r\\n                class=\\\"form-input\\\" style=\\\"width: 100%; padding: 6px 10px; font-size: 13px;\\\" placeholder=\\\"1\\\">\\r\\n            </div>\\r\\n            <div>\\r\\n              <label style=\\\"font-size: 11px; opacity: 0.7; display: block; margin-bottom: 7px;\\\">默认 top_p</label>\\r\\n              <input type=\\\"number\\\" step=\\\"0.01\\\" min=\\\"0\\\" max=\\\"1\\\" v-model=\\\"geminiCliSettingsForm.DEFAULT_TOP_P\\\"\\r\\n                class=\\\"form-input\\\" style=\\\"width: 100%; padding: 6px 10px; font-size: 13px;\\\" placeholder=\\\"0.95\\\">\\r\\n            </div>\\r\\n            <div>\\r\\n              <label style=\\\"font-size: 11px; opacity: 0.7; display: block; margin-bottom: 7px;\\\">默认 top_k</label>\\r\\n              <input type=\\\"number\\\" step=\\\"1\\\" min=\\\"1\\\" v-model=\\\"geminiCliSettingsForm.DEFAULT_TOP_K\\\" class=\\\"form-input\\\"\\r\\n                style=\\\"width: 100%; padding: 6px 10px; font-size: 13px;\\\" placeholder=\\\"64\\\">\\r\\n            </div>\\r\\n            <div>\\r\\n              <label style=\\\"font-size: 11px; opacity: 0.7; display: block; margin-bottom: 7px;\\\">默认最大\\r\\n                Tokens</label>\\r\\n              <input type=\\\"number\\\" step=\\\"1\\\" min=\\\"1\\\" v-model=\\\"geminiCliSettingsForm.DEFAULT_MAX_TOKENS\\\"\\r\\n                class=\\\"form-input\\\" style=\\\"width: 100%; padding: 6px 10px; font-size: 13px;\\\" placeholder=\\\"8192\\\">\\r\\n            </div>\\r\\n          </div>\\r\\n        </div>\\r\\n\\r\\n        <!-- 模型重定向 -->\\r\\n        <div style=\\\"margin-bottom: 24px;\\\">\\r\\n          <div\\r\\n            style=\\\"font-size: 14px; font-weight: 600; margin-bottom: 12px; color: var(--gemini-primary); display: flex; align-items: center; gap: 8px;\\\">\\r\\n            <i class=\\\"fas fa-exchange-alt\\\"></i> 模型重定向 (别名)\\r\\n          </div>\\r\\n          <!-- 列表 -->\\r\\n          <div v-if=\\\"geminiCliModelRedirects.length > 0\\\"\\r\\n            style=\\\"display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px;\\\">\\r\\n            <div v-for=\\\"r in geminiCliModelRedirects\\\" :key=\\\"r.source_model\\\"\\r\\n              style=\\\"background: var(--bg-tertiary); padding: 10px 15px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border-color); transition: all 0.2s;\\\"\\r\\n              :style=\\\"gcliEditingRedirectSource === r.source_model ? 'border-color: var(--gemini-primary); box-shadow: 0 0 0 2px rgba(var(--gemini-primary-rgb), 0.1);' : ''\\\">\\r\\n\\r\\n              <div v-if=\\\"gcliEditingRedirectSource !== r.source_model\\\"\\r\\n                style=\\\"display: flex; align-items: center; gap: 10px; flex: 1;\\\"\\r\\n                @dblclick=\\\"editGeminiCliModelRedirect(r)\\\">\\r\\n                <div\\r\\n                  style=\\\"background: rgba(var(--gemini-primary-rgb), 0.1); color: var(--gemini-primary); padding: 2px 8px; border-radius: 4px; font-weight: 600; font-size: 12px;\\\">\\r\\n                  {{ r.source_model }}</div>\\r\\n                <i class=\\\"fas fa-long-arrow-alt-right\\\" style=\\\"opacity: 0.3;\\\"></i>\\r\\n                <div style=\\\"font-size: 13px; color: var(--text-primary);\\\">{{ r.target_model }}</div>\\r\\n              </div>\\r\\n\\r\\n              <div v-else style=\\\"display: flex; align-items: center; gap: 10px; flex: 1;\\\">\\r\\n                <input type=\\\"text\\\" v-model=\\\"newGeminiCliRedirectSource\\\" class=\\\"form-input-sm\\\"\\r\\n                  style=\\\"flex: 1; min-width: 0;\\\" placeholder=\\\"源模型\\\">\\r\\n                <i class=\\\"fas fa-long-arrow-alt-right\\\" style=\\\"opacity: 0.3;\\\"></i>\\r\\n                <input type=\\\"text\\\" v-model=\\\"newGeminiCliRedirectTarget\\\" class=\\\"form-input-sm\\\"\\r\\n                  style=\\\"flex: 1; min-width: 0;\\\" placeholder=\\\"目标模型\\\">\\r\\n              </div>\\r\\n\\r\\n              <div style=\\\"display: flex; gap: 6px; margin-left: 15px;\\\">\\r\\n                <template v-if=\\\"gcliEditingRedirectSource === r.source_model\\\">\\r\\n                  <button class=\\\"btn btn-xs btn-success icon-only\\\"\\r\\n                    @click=\\\"addGeminiCliModelRedirect(newGeminiCliRedirectSource, newGeminiCliRedirectTarget)\\\"\\r\\n                    title=\\\"保存\\\">\\r\\n                    <i class=\\\"fas fa-check\\\"></i>\\r\\n                  </button>\\r\\n                  <button class=\\\"btn btn-xs btn-secondary icon-only\\\"\\r\\n                    @click=\\\"gcliEditingRedirectSource = null; newGeminiCliRedirectSource = ''; newGeminiCliRedirectTarget = '';\\\"\\r\\n                    title=\\\"取消\\\">\\r\\n                    <i class=\\\"fas fa-times\\\"></i>\\r\\n                  </button>\\r\\n                </template>\\r\\n                <template v-else>\\r\\n                  <button class=\\\"btn btn-xs btn-primary icon-only\\\" @click=\\\"editGeminiCliModelRedirect(r)\\\" title=\\\"编辑\\\">\\r\\n                    <i class=\\\"fas fa-pen\\\"></i>\\r\\n                  </button>\\r\\n                  <button class=\\\"btn btn-xs btn-danger icon-only\\\" @click=\\\"removeGeminiCliModelRedirect(r.source_model)\\\"\\r\\n                    title=\\\"删除\\\">\\r\\n                    <i class=\\\"fas fa-trash\\\"></i>\\r\\n                  </button>\\r\\n                </template>\\r\\n              </div>\\r\\n            </div>\\r\\n          </div>\\r\\n          <div v-else\\r\\n            style=\\\"font-size: 12px; opacity: 0.5; margin-bottom: 16px; padding: 10px; background: var(--bg-secondary); border-radius: 8px; text-align: center; border: 1px dashed var(--border-color);\\\">\\r\\n            暂无重定向规则。请求 source 模型将自动转发给 target 模型。\\r\\n          </div>\\r\\n\\r\\n          <!-- 添加表单 -->\\r\\n          <div v-if=\\\"!gcliEditingRedirectSource\\\"\\r\\n            style=\\\"display: flex; gap: 10px; align-items: center; background: rgba(var(--gemini-primary-rgb), 0.03); padding: 12px; border-radius: 10px; border: 1px dashed var(--border-color);\\\">\\r\\n            <div style=\\\"flex: 1; position: relative;\\\">\\r\\n              <input type=\\\"text\\\" v-model=\\\"newGeminiCliRedirectSource\\\" class=\\\"form-input\\\"\\r\\n                style=\\\"width: 100%; padding: 8px 12px; font-size: 13px;\\\" placeholder=\\\"源模型 (例如: gpt-4o)\\\">\\r\\n            </div>\\r\\n            <i class=\\\"fas fa-arrow-right\\\" style=\\\"opacity: 0.3;\\\"></i>\\r\\n            <div style=\\\"flex: 1; position: relative;\\\">\\r\\n              <input type=\\\"text\\\" v-model=\\\"newGeminiCliRedirectTarget\\\" class=\\\"form-input\\\"\\r\\n                style=\\\"width: 100%; padding: 8px 12px; font-size: 13px;\\\" placeholder=\\\"目标模型 (例如: gemini-1.5-pro)\\\">\\r\\n            </div>\\r\\n            <button class=\\\"btn btn-gemini\\\"\\r\\n              style=\\\"padding: 0 20px; font-size: 13px; height: 38px; display: flex; align-items: center; gap: 6px; white-space: nowrap;\\\"\\r\\n              @click=\\\"addGeminiCliModelRedirect(newGeminiCliRedirectSource, newGeminiCliRedirectTarget)\\\">\\r\\n              <i class=\\\"fas fa-plus-circle\\\"></i> 添加别名\\r\\n            </button>\\r\\n          </div>\\r\\n        </div>\\r\\n\\r\\n        <!-- 底部设置网格 -->\\r\\n        <div\\r\\n          style=\\\"display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 10px;\\\">\\r\\n\\r\\n          <!-- 安全与负载 -->\\r\\n          <div>\\r\\n            <div style=\\\"font-size: 13px; font-weight: 600; margin-bottom: 10px; color: var(--gemini-primary);\\\">\\r\\n              <i class=\\\"fas fa-shield-alt\\\"></i> 安全与负载\\r\\n            </div>\\r\\n            <div style=\\\"display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 12px;\\\">\\r\\n              <div>\\r\\n                <label style=\\\"font-size: 11px; opacity: 0.7; display: block; margin-bottom: 7px;\\\">每小时上限</label>\\r\\n                <input type=\\\"number\\\" v-model=\\\"geminiCliSettingsForm.CREDENTIAL_MAX_USAGE_PER_HOUR\\\" class=\\\"form-input\\\"\\r\\n                  style=\\\"width: 100%; padding: 6px 10px; font-size: 13px;\\\" placeholder=\\\"1000\\\">\\r\\n              </div>\\r\\n              <div>\\r\\n                <label style=\\\"font-size: 11px; opacity: 0.7; display: block; margin-bottom: 7px;\\\">超时 (s)</label>\\r\\n                <input type=\\\"number\\\" v-model=\\\"geminiCliSettingsForm.TIMEOUT\\\" class=\\\"form-input\\\"\\r\\n                  style=\\\"width: 100%; padding: 6px 10px; font-size: 13px;\\\" placeholder=\\\"300\\\">\\r\\n              </div>\\r\\n              <div>\\r\\n                <label style=\\\"font-size: 11px; opacity: 0.7; display: block; margin-bottom: 7px;\\\">日志保留</label>\\r\\n                <input type=\\\"number\\\" v-model=\\\"geminiCliSettingsForm.LOG_RETENTION_DAYS\\\" class=\\\"form-input\\\"\\r\\n                  style=\\\"width: 100%; padding: 6px 10px; font-size: 13px;\\\" placeholder=\\\"7\\\">\\r\\n              </div>\\r\\n            </div>\\r\\n          </div>\\r\\n        </div>\\r\\n      </div>\\r\\n    </div>\\r\\n  </div>\\r\\n</div>\\r\\n<!-- ==================== Gemini CLI 管理部分结束 ==================== -->\"\n//# sourceMappingURL=data:application/json;base64,"
