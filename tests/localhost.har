            "mimeType": "text/javascript",
            "compression": 0,
            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/css/tables.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"E:/Code/api-monitor/src/css/tables.css\"\nconst __vite__css = \"/* Table & Panel Styles */\\r\\n\\r\\n.panel {\\r\\n  line-height: 1;\\r\\n  background: var(--card-bg);\\r\\n  border-radius: 16px;\\r\\n  padding: 10px;\\r\\n  box-shadow: var(--card-shadow);\\r\\n  border: 2px solid var(--border-color);\\r\\n}\\r\\n\\r\\n.panel-header {\\r\\n  /* padding: 0px 0px 0px 4px; */\\r\\n  display: flex;\\r\\n  align-items: center;\\r\\n  min-height: 32px;\\r\\n  justify-content: space-between;\\r\\n}\\r\\n\\r\\n/* Panel Header 按钮统一高度 */\\r\\n.panel-header .btn {\\r\\n  height: 32px;\\r\\n  display: inline-flex;\\r\\n  align-items: center;\\r\\n  justify-content: center;\\r\\n  padding: 0 12px;\\r\\n  font-size: 13px;\\r\\n  line-height: 1;\\r\\n}\\r\\n\\r\\n.panel-header .btn-sm {\\r\\n  height: 28px;\\r\\n  padding: 0 10px;\\r\\n  font-size: 12px;\\r\\n}\\r\\n\\r\\n.panel-header .btn i {\\r\\n  font-size: 12px;\\r\\n}\\r\\n\\r\\n.panel-header .btn i+span,\\r\\n.panel-header .btn i:not(:last-child) {\\r\\n  margin-right: 4px;\\r\\n}\\r\\n\\r\\n.panel-title {\\r\\n  font-size: 15px;\\r\\n  font-weight: 600;\\r\\n  flex-shrink: 0;\\r\\n}\\r\\n\\r\\n.table-container {\\r\\n  display: block;\\r\\n  width: 100%;\\r\\n  overflow-x: auto;\\r\\n  -webkit-overflow-scrolling: touch;\\r\\n}\\r\\n\\r\\n.table-container::-webkit-scrollbar {\\r\\n  display: block !important;\\r\\n  height: 4px;\\r\\n}\\r\\n\\r\\n.table-container::-webkit-scrollbar-thumb {\\r\\n  background: var(--border-color);\\r\\n  border-radius: 2px;\\r\\n}\\r\\n\\r\\n.table-container::-webkit-scrollbar-track {\\r\\n  background: var(--bg-secondary);\\r\\n  border-radius: 3px;\\r\\n}\\r\\n\\r\\n.table-container::-webkit-scrollbar-thumb:hover {\\r\\n  background: var(--text-tertiary);\\r\\n}\\r\\n\\r\\n.data-table {\\r\\n  width: max-content;\\r\\n  min-width: 100%;\\r\\n  border-collapse: collapse;\\r\\n  font-size: 13px;\\r\\n  table-layout: auto;\\r\\n}\\r\\n\\r\\n.data-table th,\\r\\n.data-table td {\\r\\n  padding: 10px 12px;\\r\\n  text-align: left;\\r\\n  border-bottom: 1px solid var(--border-color);\\r\\n  color: var(--text-primary);\\r\\n  white-space: nowrap !important;\\r\\n  vertical-align: middle !important;\\r\\n}\\r\\n\\r\\n.data-table th.text-center,\\r\\n.data-table td.text-center {\\r\\n  text-align: center !important;\\r\\n}\\r\\n\\r\\n.data-table th {\\r\\n  background: var(--bg-secondary);\\r\\n  font-weight: 600;\\r\\n  color: var(--text-secondary);\\r\\n  position: sticky;\\r\\n  top: 0;\\r\\n  z-index: 10;\\r\\n}\\r\\n\\r\\n.data-table tr:hover {\\r\\n  background: var(--bg-secondary);\\r\\n}\\r\\n\\r\\n/* 统一操作列和单元格内 flex 布局 */\\r\\n.data-table td.actions,\\r\\n.data-table td .flex-cell {\\r\\n  vertical-align: middle;\\r\\n}\\r\\n\\r\\n.data-table td.actions>div,\\r\\n.data-table td .flex-cell {\\r\\n  display: inline-flex !important;\\r\\n  align-items: center;\\r\\n  justify-content: center;\\r\\n  gap: 8px;\\r\\n  white-space: nowrap !important;\\r\\n  flex-wrap: nowrap !important;\\r\\n  margin: 0 auto;\\r\\n}\\r\\n\\r\\n/* 方法标签样式 */\\r\\n.method-badge {\\r\\n  font-size: 10px;\\r\\n  font-weight: 800;\\r\\n  padding: 2px 5px;\\r\\n  border-radius: 4px;\\r\\n  margin-right: 6px;\\r\\n  font-family: var(--font-mono);\\r\\n  text-transform: uppercase;\\r\\n}\\r\\n\\r\\n.method-post {\\r\\n  background: rgba(var(--primary-rgb), 0.1);\\r\\n  color: var(--primary-color);\\r\\n}\\r\\n\\r\\n.method-get {\\r\\n  background: rgba(16, 185, 129, 0.1);\\r\\n  color: #10b981;\\r\\n}\\r\\n\\r\\n.method-put {\\r\\n  background: rgba(245, 158, 11, 0.1);\\r\\n  color: #f59e0b;\\r\\n}\\r\\n\\r\\n.method-delete {\\r\\n  background: rgba(239, 68, 68, 0.1);\\r\\n  color: #ef4444;\\r\\n}\\r\\n\\r\\n.log-path {\\r\\n  font-family: var(--font-mono);\\r\\n  font-size: 11px;\\r\\n  color: var(--text-secondary);\\r\\n  max-width: 240px;\\r\\n  overflow: hidden;\\r\\n  text-overflow: ellipsis;\\r\\n  display: inline-block;\\r\\n  vertical-align: middle;\\r\\n}\\r\\n\\r\\n.log-time {\\r\\n  font-size: 11px;\\r\\n  color: var(--text-tertiary);\\r\\n  white-space: nowrap;\\r\\n}\\r\\n\\r\\n.log-duration {\\r\\n  font-size: 11px;\\r\\n  font-weight: 600;\\r\\n  color: var(--text-secondary);\\r\\n  font-family: var(--font-mono);\\r\\n}\\r\\n\\r\\n/* 负载均衡勋章 */\\r\\n.badge-lb {\\r\\n  background: rgba(139, 92, 246, 0.1);\\r\\n  color: #8b5cf6;\\r\\n  border: 1px solid rgba(139, 92, 246, 0.2);\\r\\n  font-size: 10px;\\r\\n  padding: 1px 4px;\\r\\n  border-radius: 4px;\\r\\n  font-weight: 700;\\r\\n  margin-left: 4px;\\r\\n  display: inline-block;\\r\\n  line-height: 1;\\r\\n}\\r\\n\\r\\n/* 如果需要左对齐，可以覆盖 */\\r\\n.data-table td .flex-cell.justify-start {\\r\\n  justify-content: flex-start;\\r\\n}\\r\\n\\r\\n.data-table td.actions {\\r\\n  width: 1px;\\r\\n  white-space: nowrap;\\r\\n  text-align: center !important;\\r\\n}\\r\\n\\r\\n.data-table td.actions>div {\\r\\n  width: 100%;\\r\\n  justify-content: center;\\r\\n}\\r\\n\\r\\n/* OpenAI Table */\\r\\n.openai-table-container {\\r\\n  overflow-x: auto;\\r\\n  max-width: 100%;\\r\\n  -webkit-overflow-scrolling: touch;\\r\\n}\\r\\n\\r\\n.openai-table {\\r\\n  width: max-content;\\r\\n  min-width: 100%;\\r\\n  border-collapse: collapse;\\r\\n  font-size: 13px;\\r\\n  table-layout: auto;\\r\\n}\\r\\n\\r\\n.openai-table th,\\r\\n.openai-table td {\\r\\n  padding: 10px 16px;\\r\\n  text-align: left;\\r\\n  border-bottom: 1px solid var(--border-color);\\r\\n  color: var(--text-primary);\\r\\n  white-space: nowrap;\\r\\n}\\r\\n\\r\\n.openai-table th {\\r\\n  background: var(--bg-secondary);\\r\\n  font-weight: 600;\\r\\n  color: var(--text-secondary);\\r\\n  position: sticky;\\r\\n  top: 0;\\r\\n  z-index: 1;\\r\\n}\\r\\n\\r\\n.openai-table tr:hover {\\r\\n  background: var(--bg-secondary);\\r\\n}\\r\\n\\r\\n.openai-table td.actions {\\r\\n  padding: 10px 16px;\\r\\n  vertical-align: middle;\\r\\n}\\r\\n\\r\\n.openai-table td.actions>*:not(:last-child) {\\r\\n  margin-right: 6px;\\r\\n}\\r\\n\\r\\n.openai-table .cell-name {\\r\\n  max-width: 200px;\\r\\n  overflow: hidden;\\r\\n  text-overflow: ellipsis;\\r\\n}\\r\\n\\r\\n.openai-table .cell-url {\\r\\n  max-width: 300px;\\r\\n  overflow: hidden;\\r\\n  text-overflow: ellipsis;\\r\\n  font-size: 12px;\\r\\n}\\r\\n\\r\\n.openai-table .cell-key {\\r\\n  max-width: 200px;\\r\\n  overflow: hidden;\\r\\n  text-overflow: ellipsis;\\r\\n  font-size: 12px;\\r\\n}\\r\\n\\r\\n.openai-table .cell-models {\\r\\n  max-width: 300px;\\r\\n}\\r\\n\\r\\n.copy-btn {\\r\\n  padding: 4px 8px;\\r\\n  background: var(--bg-tertiary);\\r\\n  border: 1px solid var(--border-color);\\r\\n  border-radius: 4px;\\r\\n  cursor: pointer;\\r\\n  font-size: 11px;\\r\\n  color: var(--text-secondary);\\r\\n  transition: all 0.2s;\\r\\n  display: inline-flex;\\r\\n  align-items: center;\\r\\n  gap: 4px;\\r\\n  white-space: nowrap;\\r\\n}\\r\\n\\r\\n.copy-btn:hover {\\r\\n  background: var(--primary-color);\\r\\n  color: white;\\r\\n  border-color: var(--primary-color);\\r\\n}\\r\\n\\r\\n.copy-btn.copied {\\r\\n  background: var(--success-color);\\r\\n  color: white;\\r\\n  border-color: var(--success-color);\\r\\n}\\r\\n\\r\\n@media (max-width: 480px) {\\r\\n  .panel-header {\\r\\n    flex-direction: column;\\r\\n    align-items: flex-start;\\r\\n    gap: 8px;\\r\\n  }\\r\\n\\r\\n  .data-table {\\r\\n    font-size: 11px;\\r\\n  }\\r\\n\\r\\n  .data-table th,\\r\\n  .data-table td {\\r\\n    padding: 6px 8px;\\r\\n  }\\r\\n\\r\\n  .openai-table-container {\\r\\n    overflow-x: auto;\\r\\n    -webkit-overflow-scrolling: touch;\\r\\n  }\\r\\n\\r\\n  .openai-table {\\r\\n    min-width: 100%;\\r\\n    font-size: 12px;\\r\\n  }\\r\\n\\r\\n  .openai-table th,\\r\\n  .openai-table td {\\r\\n    padding: 8px 10px;\\r\\n    white-space: nowrap;\\r\\n  }\\r\\n\\r\\n  .data-table,\\r\\n  .openai-table {\\r\\n    min-width: 600px !important;\\r\\n  }\\r\\n\\r\\n  .openai-table .cell-url,\\r\\n  .openai-table .cell-key,\\r\\n  .openai-table .cell-name {\\r\\n    max-width: none;\\r\\n    white-space: nowrap;\\r\\n  }\\r\\n}\\r\\n\\r\\n/* 模型配额通用显示样式 (用于账号列表等) */\\r\\n.quota-grid {\\r\\n  display: grid;\\r\\n  grid-template-columns: repeat(2, 1fr);\\r\\n  gap: 4px 12px;\\r\\n}\\r\\n\\r\\n.quota-item {\\r\\n  display: flex;\\r\\n  align-items: center;\\r\\n  gap: 6px;\\r\\n  font-size: 11px;\\r\\n}\\r\\n\\r\\n.quota-label {\\r\\n  min-width: 60px;\\r\\n  font-weight: 500;\\r\\n  color: var(--text-secondary);\\r\\n}\\r\\n\\r\\n.quota-bar-wrapper {\\r\\n  display: flex;\\r\\n  align-items: center;\\r\\n  gap: 10px;\\r\\n  flex: 1;\\r\\n}\\r\\n\\r\\n.quota-bar {\\r\\n  flex: 1;\\r\\n  height: 8px;\\r\\n  border-radius: 6px;\\r\\n  background: rgba(0, 0, 0, 0.05);\\r\\n  /* 更淡的背景 */\\r\\n  overflow: hidden;\\r\\n  min-width: 40px;\\r\\n}\\r\\n\\r\\n.quota-fill {\\r\\n  height: 100%;\\r\\n  border-radius: 6px;\\r\\n  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);\\r\\n}\\r\\n\\r\\n.quota-value,\\r\\n.quota-percent {\\r\\n  min-width: 35px;\\r\\n  text-align: right;\\r\\n  font-weight: 600;\\r\\n  font-size: 11px;\\r\\n  font-family: var(--font-mono);\\r\\n}\\r\\n\\r\\n/* 适配深色模式 */\\r\\n[data-theme='dark'] .quota-bar {\\r\\n  background: rgba(255, 255, 255, 0.1);\\r\\n}\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
