            "compression": 0,
            "text": "export default \"<!-- 模板模块 UI -->\\r\\n<template id=\\\"{{module_name}}-template\\\">\\r\\n    <div class=\\\"module-container {{module_name}}-module\\\">\\r\\n        <!-- 头部工具栏 -->\\r\\n        <div class=\\\"module-header\\\">\\r\\n            <div class=\\\"title-area\\\">\\r\\n                <i class=\\\"fas fa-cube\\\"></i>\\r\\n                <h2>{{module_title}}</h2>\\r\\n            </div>\\r\\n            <div class=\\\"actions\\\">\\r\\n                <button class=\\\"btn btn-primary\\\" @click=\\\"fetch{{ModuleName}}Data\\\" :disabled=\\\"refreshing\\\">\\r\\n                    <i class=\\\"fas fa-sync-alt\\\" :class=\\\"{'fa-spin': refreshing}\\\"></i> 刷新\\r\\n                </button>\\r\\n                <button class=\\\"btn btn-success\\\" @click=\\\"showAddModal = true\\\">\\r\\n                    <i class=\\\"fas fa-plus\\\"></i> 添加账号\\r\\n                </button>\\r\\n            </div>\\r\\n        </div>\\r\\n\\r\\n        <!-- 数据列表/卡片 -->\\r\\n        <div class=\\\"module-content\\\">\\r\\n            <div v-if=\\\"loading\\\" class=\\\"loading-state\\\">\\r\\n                <i class=\\\"fas fa-spinner fa-spin\\\"></i> 加载中...\\r\\n            </div>\\r\\n            \\r\\n            <div v-else-if=\\\"accounts.length === 0\\\" class=\\\"empty-state\\\">\\r\\n                <i class=\\\"fas fa-folder-open\\\"></i>\\r\\n                <p>暂无数据，请先添加账号</p>\\r\\n            </div>\\r\\n\\r\\n            <div v-else class=\\\"data-grid\\\">\\r\\n                <!-- 循环展示数据 -->\\r\\n                <div v-for=\\\"account in accounts\\\" :key=\\\"account.id\\\" class=\\\"data-card\\\">\\r\\n                    <div class=\\\"card-header\\\">\\r\\n                        <h3>{{ account.name }}</h3>\\r\\n                        <span class=\\\"status-badge\\\" :class=\\\"account.status\\\">{{ account.status }}</span>\\r\\n                    </div>\\r\\n                    <div class=\\\"card-body\\\">\\r\\n                        <!-- 账号明细 -->\\r\\n                    </div>\\r\\n                </div>\\r\\n            </div>\\r\\n        </div>\\r\\n    </div>\\r\\n</template>\\r\\n\"\n//# sourceMappingURL=data:application/json;base64,"
